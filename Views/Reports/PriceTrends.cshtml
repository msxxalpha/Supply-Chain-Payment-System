@model Indamin.Payment.Services.PriceListAnalysisData
@using Indamin.Payment.Services
@{
    ViewData["Title"] = "تحلیل فهرست بها و روند قیمت";
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.FilteredTrendCount / (double)Model.PageSize));
    string PageUrl(int page) => Url.Action("PriceTrends", "Reports", new { q = Model.Search, changeType = Model.ChangeType, status = Model.Status, page, pageSize = Model.PageSize }) ?? "/Reports/PriceTrends";
}
<div class="page-header">
 <div>
  <div class="eyebrow">تحلیل خرید و زنجیره تأمین</div>
  <h2>داشبورد فهرست بها و روند تغییرات قیمت</h2>
  <p class="text-muted">مقایسه آخرین نرخ ثبت‌شده هر کالا نزد هر تأمین‌کننده با نرخ قبلی همان ارتباط، همراه با اعتبار نرخ‌ها و تاریخچه تغییرات.</p>
 </div>
 <div class="export-group">
  @if (User.HasClaim("Permission", "Setup.SupplierPriceList")) { <a class="btn btn-main" href="/SupplierPriceList">مدیریت فهرست بها</a> }
  @if (User.HasClaim("Permission", "Reports.View")) { <a class="btn btn-outline-secondary" href="/Reports">داشبورد مالی</a> }
 </div>
</div>

<div class="payment-kpi-grid report-kpis">
 <div class="payment-kpi"><span>کل رکوردهای فهرست بها</span><strong>@Model.TotalRecords.ToString("N0")</strong><small>شامل تاریخچه نرخ‌های ثبت‌شده</small></div>
 <div class="payment-kpi"><span>نرخ معتبر امروز</span><strong>@Model.ActiveNowCount.ToString("N0")</strong><small>فعال و در بازه اعتبار جاری</small></div>
 <div class="payment-kpi"><span>تغییرات افزایشی</span><strong>@Model.IncreasedCount.ToString("N0")</strong><small>نسبت به نرخ قبلی همان کالا و تأمین‌کننده</small></div>
 <div class="payment-kpi"><span>تغییرات کاهشی</span><strong>@Model.DecreasedCount.ToString("N0")</strong><small>نسبت به نرخ قبلی همان کالا و تأمین‌کننده</small></div>
</div>

<div class="row g-3 mt-1">
 <div class="col-xl-4"><div class="form-panel h-100"><div class="panel-title"><div><h4>پوشش فهرست بها</h4><span>گستره داده‌های قیمت ثبت‌شده</span></div></div><div class="supplier-debt-cards"><div><span>تأمین‌کنندگان دارای نرخ</span><b>@Model.SupplierCount.ToString("N0")</b></div><div><span>کالاهای دارای نرخ</span><b>@Model.PartCount.ToString("N0")</b></div><div><span>بدون تغییر نسبت به نرخ قبلی</span><b>@Model.UnchangedCount.ToString("N0")</b></div></div></div></div>
 <div class="col-xl-8"><div class="form-panel h-100"><div class="panel-title"><div><h4>خلاصه تغییر قیمت</h4><span>میانگین ساده درصد تغییر برای ارتباط‌هایی که حداقل دو نرخ دارند</span></div><span class="priority-pill">@Model.AverageChangePercent.ToString("+0.00;-0.00;0.00")٪</span></div><p class="text-muted mb-0">درصد تغییر هر ردیف از مقایسه آخرین نرخ ثبت‌شده با نرخ قبلی همان کالا نزد همان تأمین‌کننده محاسبه شده است. این شاخص میانگین ساده است و بر اساس مبلغ خرید یا حجم مصرف وزن‌دهی نشده است.</p></div></div>
</div>

<div class="form-panel mt-3">
 <div class="panel-title"><div><h4>روند تغییر نرخ به تفکیک کالا و تأمین‌کننده</h4><span>جست‌وجو در کد/نام تأمین‌کننده و کد/عنوان کالا، همراه با فیلتر نوع تغییر و وضعیت نرخ.</span></div><span class="mini-label">@Model.FilteredTrendCount.ToString("N0") نتیجه</span></div>
 <form method="get" action="/Reports/PriceTrends" class="row g-2 align-items-end mb-3">
  <div class="col-xl-4 col-md-6"><label class="form-label">جست‌وجو</label><input class="form-control" name="q" value="@Model.Search" placeholder="کد یا نام تأمین‌کننده / کالا"></div>
  <div class="col-xl-2 col-md-6"><label class="form-label">نوع تغییر قیمت</label><select class="form-select" name="changeType"><option value="">همه تغییرات</option><option value="increase" selected="@(Model.ChangeType == "increase")">افزایشی</option><option value="decrease" selected="@(Model.ChangeType == "decrease")">کاهشی</option><option value="unchanged" selected="@(Model.ChangeType == "unchanged")">بدون تغییر</option></select></div>
  <div class="col-xl-2 col-md-6"><label class="form-label">وضعیت نرخ</label><select class="form-select" name="status"><option value="">همه وضعیت‌ها</option><option value="active" selected="@(Model.Status == "active")">معتبر امروز</option><option value="inactive" selected="@(Model.Status == "inactive")">غیرفعال</option><option value="expired" selected="@(Model.Status == "expired")">خارج از اعتبار</option></select></div>
  <div class="col-xl-2 col-md-6"><label class="form-label">تعداد در صفحه</label><select class="form-select" name="pageSize"><option value="25" selected="@(Model.PageSize == 25)">۲۵ ردیف</option><option value="50" selected="@(Model.PageSize == 50)">۵۰ ردیف</option><option value="75" selected="@(Model.PageSize == 75)">۷۵ ردیف</option><option value="100" selected="@(Model.PageSize == 100)">۱۰۰ ردیف</option></select></div>
  <div class="col-xl-2 col-md-6 d-flex gap-2"><button class="btn btn-main" type="submit">اعمال فیلتر</button><a class="btn btn-outline-secondary" href="/Reports/PriceTrends">پاک‌کردن</a></div>
 </form>
 <div class="table-responsive">
  <table class="table modern-table align-middle">
   <thead><tr><th>تأمین‌کننده</th><th>کد کالا</th><th>عنوان کالا</th><th>نرخ قبلی</th><th>آخرین نرخ</th><th>تغییر مبلغ</th><th>تغییر درصد</th><th>شروع اعتبار آخرین نرخ</th><th>پایان اعتبار</th><th>وضعیت</th><th>تاریخچه نرخ</th></tr></thead>
   <tbody>
   @foreach (var x in Model.Trends)
   {
    <tr>
     <td><div class="fw-bold">@x.SupplierTitle</div><small class="text-muted">@x.SupplierCode</small></td>
     <td>@x.PartCode</td><td>@x.PartTitle</td>
     <td>@(x.PreviousPrice.HasValue ? x.PreviousPrice.Value.ToString("N0") : "—")</td>
     <td class="amount-emphasis">@x.LatestPrice.ToString("N0")</td>
     <td class="@(x.ChangeAmount > 0 ? "text-danger" : x.ChangeAmount < 0 ? "text-success" : "")">@((x.ChangeAmount > 0 ? "+" : "") + x.ChangeAmount.ToString("N0"))</td>
     <td class="@(x.ChangePercent > 0 ? "text-danger" : x.ChangePercent < 0 ? "text-success" : "")">@x.ChangePercent.ToString("+0.00;-0.00;0.00")٪</td>
     <td>@PersianDateService.ToJalali(x.LatestValidFrom)</td>
     <td>@PersianDateService.ToJalali(x.LatestValidTo)</td>
     <td>@if (x.LatestActive && x.LatestValidFrom.Date <= DateTime.Today && x.LatestValidTo.Date >= DateTime.Today) { <span class="validation-chip validation-ok">معتبر امروز</span> } else if (!x.LatestActive) { <span class="mini-label">غیرفعال</span> } else { <span class="mini-label">خارج از اعتبار</span> }</td>
     <td><button type="button" class="btn btn-sm btn-outline-primary price-history-open" data-supplier-part-id="@x.SupplierPartId" data-history-count="@x.HistoryCount">@x.HistoryCount.ToString("N0") نرخ</button></td>
    </tr>
   }
   @if (Model.Trends.Count == 0) { <tr><td colspan="11" class="text-center text-muted py-4">با فیلترهای انتخاب‌شده موردی پیدا نشد.</td></tr> }
   </tbody>
  </table>
 </div>
 <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
  <small class="text-muted">صفحه @Model.Page از @totalPages — نمایش @Model.Trends.Count.ToString("N0") مورد از @Model.FilteredTrendCount.ToString("N0") نتیجه</small>
  <nav aria-label="صفحه‌بندی روند قیمت"><ul class="pagination pagination-sm mb-0">
   <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@(Model.Page <= 1 ? "#" : PageUrl(Model.Page - 1))">قبلی</a></li>
   @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(totalPages, Model.Page + 2); p++) { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@PageUrl(p)">@p</a></li> }
   <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")"><a class="page-link" href="@(Model.Page >= totalPages ? "#" : PageUrl(Model.Page + 1))">بعدی</a></li>
  </ul></nav>
 </div>
</div>

<div class="form-panel mt-3">
 <div class="panel-title"><div><h4>آخرین تغییرات ثبت‌شده</h4><span>۱۰۰ رکورد آخر بر اساس زمان آخرین ویرایش</span></div></div>
 <div class="table-responsive">
  <table class="table modern-table">
   <thead><tr><th>آخرین ویرایش</th><th>تأمین‌کننده</th><th>کالا</th><th>قیمت</th><th>از تاریخ</th><th>تا تاریخ</th><th>وضعیت رکورد</th></tr></thead>
   <tbody>
   @foreach (var x in Model.RecentHistory)
   {
    <tr><td>@PersianDateService.ToJalali(x.UpdatedAt)</td><td>@x.SupplierTitle <small class="text-muted">(@x.SupplierCode)</small></td><td>@x.PartTitle <small class="text-muted">(@x.PartCode)</small></td><td class="amount-emphasis">@x.PurchasePrice.ToString("N0")</td><td>@PersianDateService.ToJalali(x.ValidFrom)</td><td>@PersianDateService.ToJalali(x.ValidTo)</td><td>@(x.IsActive ? "فعال" : "غیرفعال")</td></tr>
   }
   @if (Model.RecentHistory.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">تاریخچه‌ای برای نمایش وجود ندارد.</td></tr> }
   </tbody>
  </table>
 </div>
</div>

<div class="modal fade" id="priceHistoryModal" tabindex="-1" aria-labelledby="priceHistoryTitle" aria-hidden="true">
 <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
  <div class="modal-content border-0 shadow-lg">
   <div class="modal-header"><div><h5 class="modal-title" id="priceHistoryTitle">تاریخچه تغییرات نرخ</h5><div id="priceHistorySubtitle" class="text-muted small mt-1">در حال دریافت اطلاعات…</div></div><button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="بستن"></button></div>
   <div class="modal-body">
    <div id="priceHistoryLoading" class="text-center py-4">در حال بارگذاری تاریخچه نرخ…</div>
    <div id="priceHistoryError" class="alert alert-danger d-none"></div>
    <div id="priceHistoryContent" class="d-none">
     <div class="table-responsive mb-4"><table class="table modern-table align-middle"><thead><tr><th>ردیف</th><th>قیمت خرید</th><th>شروع اعتبار</th><th>پایان اعتبار</th><th>آخرین ویرایش</th><th>وضعیت</th></tr></thead><tbody id="priceHistoryRows"></tbody></table></div>
     <div class="form-panel"><div class="panel-title"><div><h5 class="mb-1">نمودار خطی روند قیمت</h5><span>قیمت هر رکورد بر اساس تاریخ شروع اعتبار</span></div></div><div style="height:320px;position:relative"><canvas id="priceHistoryChart" role="img" aria-label="نمودار خطی تغییرات نرخ در طول زمان"></canvas></div></div>
    </div>
   </div>
  </div>
 </div>
</div>

@section Scripts {
 <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
 <script>
 (() => {
   const modalElement = document.getElementById('priceHistoryModal');
   if (!modalElement) return;
   const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
   const loading = document.getElementById('priceHistoryLoading');
   const error = document.getElementById('priceHistoryError');
   const content = document.getElementById('priceHistoryContent');
   const rowsElement = document.getElementById('priceHistoryRows');
   const subtitle = document.getElementById('priceHistorySubtitle');
   let chart = null;
   const fmt = value => new Intl.NumberFormat('fa-IR', { maximumFractionDigits: 2 }).format(value);
   const el = (tag, text, className) => { const node = document.createElement(tag); node.textContent = text; if (className) node.className = className; return node; };

   document.querySelectorAll('.price-history-open').forEach(button => button.addEventListener('click', async () => {
     loading.classList.remove('d-none'); error.classList.add('d-none'); content.classList.add('d-none');
     rowsElement.replaceChildren(); subtitle.textContent = 'در حال دریافت اطلاعات…';
     if (chart) { chart.destroy(); chart = null; }
     modal.show();
     try {
       const response = await fetch('/Reports/PriceHistory?supplierPartId=' + encodeURIComponent(button.dataset.supplierPartId), { headers: { 'Accept': 'application/json' } });
       if (!response.ok) throw new Error(response.status === 404 ? 'ارتباط کالا و تأمین‌کننده پیدا نشد.' : 'دریافت تاریخچه نرخ ناموفق بود.');
       const data = await response.json();
       document.getElementById('priceHistoryTitle').textContent = 'تاریخچه تغییرات نرخ';
       subtitle.textContent = data.supplierTitle + ' (' + data.supplierCode + ') — ' + data.partTitle + ' (' + data.partCode + ')';
       data.history.forEach((item, index) => {
         const tr = document.createElement('tr');
         tr.append(el('td', fmt(index + 1)));
         tr.append(el('td', fmt(item.purchasePrice), 'amount-emphasis'));
         tr.append(el('td', item.validFrom));
         tr.append(el('td', item.validTo));
         tr.append(el('td', item.updatedAt));
         tr.append(el('td', item.isActive ? 'فعال' : 'غیرفعال', item.isActive ? 'text-success' : 'text-muted'));
         rowsElement.append(tr);
       });
       if (data.history.length === 0) {
         const tr = document.createElement('tr'), td = el('td', 'برای این کالا و تأمین‌کننده تاریخچه‌ای ثبت نشده است.', 'text-center text-muted py-4');
         td.colSpan = 6; tr.append(td); rowsElement.append(tr);
       }
       loading.classList.add('d-none'); content.classList.remove('d-none');
       const labels = data.history.map(x => x.validFrom);
       const prices = data.history.map(x => Number(x.purchasePrice));
       if (window.Chart && prices.length) {
         chart = new Chart(document.getElementById('priceHistoryChart'), {
           type: 'line',
           data: { labels, datasets: [{ label: 'قیمت خرید', data: prices, borderColor: '#2d7fb3', backgroundColor: 'rgba(45,127,179,.12)', pointRadius: 4, pointHoverRadius: 6, tension: .2, fill: true }] },
           options: { responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' }, plugins: { legend: { display: true, rtl: true }, tooltip: { callbacks: { label: context => 'قیمت: ' + fmt(context.parsed.y) } } }, scales: { x: { title: { display: true, text: 'شروع اعتبار' } }, y: { beginAtZero: false, ticks: { callback: value => fmt(value) }, title: { display: true, text: 'قیمت خرید' } } } }
         });
       } else if (!window.Chart) {
         error.textContent = 'کتابخانه نمودار بارگذاری نشد؛ فهرست تاریخچه در دسترس است.';
         error.classList.remove('d-none');
       }
     } catch (e) {
       loading.classList.add('d-none'); error.textContent = e.message || 'خطا در دریافت تاریخچه نرخ.'; error.classList.remove('d-none');
     }
   }));
   modalElement.addEventListener('hidden.bs.modal', () => { if (chart) { chart.destroy(); chart = null; } });
 })();
 </script>
}
