@model Indamin.Payment.Services.FinancialDashboardData
@using Indamin.Payment.Data
@{
 ViewData["Title"]="داشبورد و گزارش‌های مالی زنجیره تأمین";
 var types=new[]{
  ("محاسبه تخصیص مبلغ",Model.PaymentTypes.Calculated),
  ("نقدی",Model.PaymentTypes.Cash),
  ("واگذاری چک",Model.PaymentTypes.Check),
  ("واگذاری خودرو",Model.PaymentTypes.Vehicle),
  ("واگذاری مواداولیه",Model.PaymentTypes.RawMaterial),
  ("معرفی نامه",Model.PaymentTypes.IntroductionLetter),
  ("حد اعتباری",Model.PaymentTypes.CreditLimit)
 };
}
<div class="page-header">
 <div><div class="eyebrow">تحلیل مالی زنجیره تأمین</div><h2>داشبورد و گزارش‌های مالی</h2><p class="text-muted">نمای یکپارچه مطالبات استقراری، مطالبات جاری، پرداخت‌های محاسباتی و پرداخت‌های غیرمحاسباتی با تفکیک نوع.</p></div>
 <div class="export-group">
  @if(User.HasClaim("Permission","Reports.SupplierOverview")){<a class="btn btn-main" href="/SupplierOverview">مرور تامین‌کننده</a>}
  @if(User.HasClaim("Permission","Payment.Calculate")){<a class="btn btn-outline-primary" href="/PaymentWizard">محاسبه جدید</a>}
  @if(User.HasClaim("Permission","Payment.NonCalculated")){<a class="btn btn-outline-primary" href="/NonCalculatedPayment">پرداخت غیرمحاسباتی</a>}
  <a class="btn btn-outline-secondary" href="/PaymentWizard/History">سوابق پرداخت</a>
 </div>
</div>

<div class="payment-kpi-grid report-kpis">
 <div class="payment-kpi"><span>مجموع مطالبات باقی‌مانده</span><strong>@Model.Remaining.ToString("N0")</strong><small>استقراری + جاری</small></div>
 <div class="payment-kpi"><span>کل پرداخت فعال</span><strong>@Model.TotalPaid.ToString("N0")</strong><small>محاسباتی + غیرمحاسباتی</small></div>
 <div class="payment-kpi"><span>تخصیص از محل محاسبات</span><strong>@Model.PaymentTypes.Calculated.ToString("N0")</strong><small>پرداخت محاسباتی</small></div>
 <div class="payment-kpi"><span>کل پرداخت غیرمحاسباتی</span><strong>@Model.PaymentTypes.NonCalculatedTotal.ToString("N0")</strong><small>شش نوع پرداخت غیرمحاسباتی</small></div>
</div>

<div class="form-panel mt-3"><div class="panel-title"><div><h4>مبنای محاسبه مطالبات جاری</h4><span>اطلاعات مؤثر در داشبورد مالی</span></div><span class="priority-pill">@((Model.CurrentClaimCalculationMethod==CurrentClaimCalculationMethod.QuantityBasedPriceList)?"فهرست بها":"ریالی")</span></div><div class="supplier-debt-cards"><div><span>روش فعال</span><b>@((Model.CurrentClaimCalculationMethod==CurrentClaimCalculationMethod.QuantityBasedPriceList)?"تعدادی بر اساس فهرست بها":"دریافت اطلاعات ریالی")</b></div><div><span>رسیدهای قیمت‌گذاری‌شده</span><b>@Model.PriceListPricedReceiptCount.ToString("N0")</b></div><div><span>نوبت‌های منبع انبار</span><b>@Model.WarehouseSourceRunCount.ToString("N0")</b></div></div></div>

<div class="row g-3 mt-1">
 <div class="col-xl-7">
  <div class="form-panel">
   <div class="panel-title"><div><h4>ترکیب انواع پرداخت</h4><span>مبالغ ثبت‌شده در پرداخت‌های فعال</span></div><span class="validation-chip validation-ok">@Model.PaymentTypes.GrandTotal.ToString("N0") ریال</span></div>
   <div class="payment-mix">
    @foreach(var item in types){
      var p=Model.PaymentTypes.GrandTotal>0?item.Item2/Model.PaymentTypes.GrandTotal*100:0;
      <div class="mix-row"><div><span>@item.Item1</span><b>@item.Item2.ToString("N0")</b></div><div class="progress"><div class="progress-bar" style="width:@p.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)%"></div></div><small>@p.ToString("0.0",System.Globalization.CultureInfo.InvariantCulture)٪</small></div>
    }
   </div>
  </div>
 </div>
 <div class="col-xl-5">
  <div class="form-panel h-100">
   <div class="panel-title"><div><h4>پوشش مالی</h4><span>کل پرداخت در برابر مبنای مطالبات تاریخی</span></div><span class="priority-pill">@((Model.Coverage*100m).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture))٪</span></div>
   <div class="coverage-visual"><div class="coverage-ring" style="--coverage:@((Model.Coverage*100m).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))%;"><div><strong>@((Model.Coverage*100m).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture))٪</strong><span>پوشش</span></div></div><div class="coverage-copy"><b>@Model.TotalPaid.ToString("N0")</b><span>پرداخت فعال</span><b>@Model.Remaining.ToString("N0")</b><span>مانده</span></div></div>
  </div>
 </div>
</div>

<div class="form-panel mt-3">
 <div class="panel-title"><div><h4>تحلیل تامین‌کنندگان</h4><span>مرتب‌شده بر اساس شاخص تحلیلی پرداخت و مانده مطالبات</span></div><span class="mini-label">@Model.Suppliers.Count تامین‌کننده</span></div>
 <div class="table-responsive"><table class="table modern-table"><thead><tr><th>تامین‌کننده</th><th>استقراری</th><th>جاری</th><th>محاسباتی</th><th>غیرمحاسباتی</th><th>کل پرداخت</th><th>مانده</th><th>پوشش</th><th>رسید باز</th><th>شاخص</th><th>مرور</th></tr></thead><tbody>
 @foreach(var x in Model.Suppliers){
  <tr><td class="fw-bold">@x.SupplierTitle</td><td>@x.InitialClaim.ToString("N0")</td><td>@x.CurrentClaims.ToString("N0")</td><td>@x.CalculatedPaid.ToString("N0")</td><td>@x.NonCalculatedTotal.ToString("N0")</td><td>@x.TotalPaid.ToString("N0")</td><td class="amount-emphasis">@x.Remaining.ToString("N0")</td><td>@((x.Coverage*100m).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture))٪</td><td>@x.OpenReceiptCount</td><td><span class="priority-pill">@x.Priority</span></td><td>@if(User.HasClaim("Permission","Reports.SupplierOverview")){<a class="btn btn-sm btn-outline-primary" href="/SupplierOverview/Index/@x.SupplierId">مشاهده</a>}</td></tr>
 }
 </tbody></table></div>
</div>

<div class="row g-3 mt-1">
 <div class="col-xl-8"><div class="form-panel"><div class="panel-title"><div><h4>گردش مالی تامین‌کنندگان</h4><span>مبنای مطالبات، پرداخت تجمعی و مانده</span></div></div><div class="table-responsive"><table class="table modern-table"><thead><tr><th>تامین‌کننده</th><th>مبنای مطالبات تاریخی</th><th>کل پرداخت فعال</th><th>مانده</th><th>پوشش</th><th>سررسید گذشته</th></tr></thead><tbody>
 @foreach(var x in Model.Suppliers.OrderByDescending(x=>x.Remaining)){<tr><td class="fw-bold">@x.SupplierTitle</td><td>@x.GrandPayableBasis.ToString("N0")</td><td>@x.TotalPaid.ToString("N0")</td><td class="amount-emphasis">@x.Remaining.ToString("N0")</td><td>@((x.Coverage*100m).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture))٪</td><td>@x.Overdue</td></tr>}
 </tbody></table></div></div></div>
 <div class="col-xl-4"><div class="form-panel"><div class="panel-title"><div><h4>پرداخت‌های اخیر</h4><span>آخرین نوبت‌های فعال</span></div></div><div class="recent-runs">@foreach(var x in Model.Trend.OrderByDescending(x=>x.RunId).Take(10)){<a href="/PaymentWizard/Details/@x.RunId" class="recent-run"><span>#@x.RunId</span><div><b>@x.Title</b><small>@x.Date · @(x.RunType==PaymentRunType.Calculated?"محاسباتی":"غیرمحاسباتی") · @(x.Status==PaymentRunStatus.PaymentOrdered?"دستور پرداخت شده":"تایید شده")</small></div><strong>@x.Amount.ToString("N0")</strong></a>}</div></div></div>
</div>

<div class="form-panel mt-3">
 <div class="panel-title"><div><h4>مانده مطالبات به تفکیک کالا</h4><span>تصویر جاری از بدهی‌های باز هر کالا</span></div></div>
 <div class="table-responsive"><table class="table modern-table"><thead><tr><th>کالا</th><th>رسید باز</th><th>مطالبه جاری</th><th>پرداخت جاری</th><th>مانده</th><th>پوشش</th><th>سررسید گذشته</th></tr></thead><tbody>
 @foreach(var x in Model.Parts){<tr><td class="fw-bold">@x.PartTitle</td><td>@x.OpenReceiptCount</td><td>@x.Original.ToString("N0")</td><td>@x.Paid.ToString("N0")</td><td class="amount-emphasis">@x.Remaining.ToString("N0")</td><td>@((x.Coverage*100m).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture))٪</td><td>@x.Overdue</td></tr>}
 </tbody></table></div>
</div>

<div class="form-panel mt-3">
 <div class="panel-title"><div><h4>مطالبات تامین‌کننده به تفکیک کالا</h4><span>قابل استفاده برای تحلیل جزئیات زنجیره تامین</span></div></div>
 <div class="table-responsive"><table class="table modern-table"><thead><tr><th>تامین‌کننده</th><th>کالا</th><th>رسید باز</th><th>مبلغ اولیه</th><th>پرداخت</th><th>مانده</th><th>پوشش</th></tr></thead><tbody>
 @foreach(var x in Model.SupplierParts){<tr><td class="fw-bold">@x.SupplierTitle</td><td>@x.PartTitle</td><td>@x.OpenReceiptCount</td><td>@x.Original.ToString("N0")</td><td>@x.Paid.ToString("N0")</td><td class="amount-emphasis">@x.Remaining.ToString("N0")</td><td>@((x.Coverage*100m).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture))٪</td></tr>}
 </tbody></table></div>
</div>