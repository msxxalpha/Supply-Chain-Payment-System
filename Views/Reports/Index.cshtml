@model Indamin.Payment.Controllers.ReportsController.ReportsVm
@using Indamin.Payment.Data
@{ViewData["Title"]="داشبورد و گزارش‌های مالی زنجیره تأمین";var maxSup=Model.Suppliers.Take(10).Select(x=>x.Allocated).DefaultIfEmpty(1).Max();var maxPart=Model.Parts.Take(10).Select(x=>x.Allocated).DefaultIfEmpty(1).Max();}

<div class="page-header"><div><div class="eyebrow">تحلیل مالی زنجیره تأمین</div><h2>داشبورد و گزارش‌های تخصیص پرداخت</h2><p class="text-muted">نمای یکپارچه وضعیت محاسبات، مطالبات باقیمانده، تخصیص‌های تاریخی و شاخص تحلیلی اولویت پرداخت.</p></div><div class="export-group"><a class="btn btn-main" href="/PaymentWizard">محاسبه جدید</a><a class="btn btn-outline-secondary" href="/PaymentWizard/History">تاریخچه</a></div></div>

<div class="payment-kpi-grid report-kpis">
 <div class="payment-kpi"><span>کل نوبت‌های محاسبه</span><strong>@Model.RunCount</strong><small>@Model.ApprovedRuns تاییدشده</small></div>
 <div class="payment-kpi"><span>کل مطالبات ثبت‌شده</span><strong>@Model.Original.ToString("N0")</strong><small>جمع بدهی رسیدهای تاییدشده</small></div>
 <div class="payment-kpi"><span>کل تخصیص تاییدشده</span><strong>@Model.Allocated.ToString("N0")</strong><small>@(Model.Coverage*100m).ToString("0.00")٪ پوشش مطالبات</small></div>
 <div class="payment-kpi"><span>مطالبات باقیمانده</span><strong>@Model.Remaining.ToString("N0")</strong><small>@Model.Suppliers.Count تامین‌کننده / @Model.Parts.Count کالا</small></div>
</div>

<div class="row g-3 mt-1">
 <div class="col-lg-7"><div class="form-panel report-chart-card"><div class="panel-title"><div><h4>روند ۱۲ نوبت اخیر</h4><span>مقایسه بودجه هر نوبت با مبلغ تخصیص‌یافته</span></div></div>
  <div class="trend-chart">@foreach(var x in Model.Trend){var pct=x.Budget>0?Math.Min(100,x.Allocated/x.Budget*100):0;<div class="trend-item"><div class="trend-label"><span>@x.Date</span><b>@x.Allocated.ToString("N0")</b></div><div class="trend-track"><div class="trend-bar" style="width:@pct.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)%"></div></div><small>@pct.ToString("0.0")٪ بودجه تخصیص یافته</small></div>}</div>
 </div></div>
 <div class="col-lg-5"><div class="form-panel report-chart-card"><div class="panel-title"><div><h4>وضعیت محاسبات</h4><span>تعداد نوبت‌ها بر اساس وضعیت</span></div></div>
  <div class="status-donut"><div class="donut-center"><strong>@Model.RunCount</strong><span>نوبت</span></div></div>
  <div class="status-legend">@foreach(var st in Enum.GetValues<PaymentRunStatus>()){var n=Model.Status.GetValueOrDefault(st);<div><span>@(st==PaymentRunStatus.Approved?"تاییدشده":st==PaymentRunStatus.Cancelled?"لغوشده":st==PaymentRunStatus.Calculated?"محاسبه‌شده":"پیش‌نویس")</span><b>@n</b></div>}</div>
 </div></div>
</div>

<div class="row g-3 mt-1">
 <div class="col-lg-6"><div class="form-panel"><div class="panel-title"><div><h4>۱۰ تامین‌کننده با بیشترین تخصیص</h4><span>مبلغ تخصیص‌یافته در سوابق تاییدشده</span></div><span class="mini-label">مبلغ</span></div><div class="report-bars">@foreach(var x in Model.Suppliers.OrderByDescending(x=>x.Allocated).Take(10)){<div class="report-bar-row"><div><span>@x.Title</span><b>@x.Allocated.ToString("N0")</b></div><div class="progress"><div class="progress-bar" style="width:@((x.Allocated/maxSup*100).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))%"></div></div></div>}</div></div></div>
 <div class="col-lg-6"><div class="form-panel"><div class="panel-title"><div><h4>۱۰ کالای با بیشترین تخصیص</h4><span>تخصیص تجمعی به تفکیک کالا</span></div><span class="mini-label">کالا</span></div><div class="report-bars">@foreach(var x in Model.Parts.OrderByDescending(x=>x.Allocated).Take(10)){<div class="report-bar-row"><div><span>@x.Title</span><b>@x.Allocated.ToString("N0")</b></div><div class="progress"><div class="progress-bar" style="width:@((x.Allocated/maxPart*100).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))%"></div></div></div>}</div></div></div>
</div>

<div class="form-panel mt-3"><div class="panel-title"><div><h4>تحلیل مالی و شاخص پیشنهادی اولویت پرداخت</h4><span>این شاخص توصیه تصمیم‌گیری خودکار نیست؛ یک ابزار تحلیلی شفاف برای کمک به بررسی اولویت‌هاست.</span></div><span class="mini-label">۰ تا ۱۰۰</span></div>
<div class="analysis-method"><b>روش محاسبه شاخص:</b> ۳۰٪ مانده بدهی + ۳۰٪ نسبت سن بدهی به مهلت قرارداد + ۲۰٪ سهم رسیدهای سررسیدگذشته + ۱۵٪ کمبود پوشش پرداخت + ۵٪ تعداد رسیدها. هرچه شاخص بالاتر باشد، برای بررسی انسانی اولویت بیشتری دارد.</div>
<div class="table-responsive"><table class="table modern-table"><thead><tr><th>تامین‌کننده</th><th>تعداد رسید</th><th>مطالبه اولیه</th><th>تخصیص تاکنون</th><th>مانده</th><th>پوشش</th><th>رسید سررسیدگذشته</th><th>شاخص تحلیلی</th></tr></thead><tbody>@foreach(var x in Model.Suppliers.Take(15)){<tr><td class="fw-bold">@x.Title</td><td>@x.Count</td><td>@x.Original.ToString("N0")</td><td>@x.Allocated.ToString("N0")</td><td class="amount-emphasis">@x.Remaining.ToString("N0")</td><td>@(x.Coverage*100m).ToString("0.0")٪</td><td>@x.Overdue</td><td><span class="priority-pill">@x.Priority</span></td></tr>}</tbody></table></div>
</div>

<div class="row g-3 mt-1">
 <div class="col-xl-7"><div class="form-panel"><div class="panel-title"><div><h4>گزارش مطالبات به تفکیک تامین‌کننده و کالا</h4><span>مانده از مطالبات ثبت‌شده در سوابق تاییدشده</span></div></div><div class="table-responsive"><table class="table modern-table"><thead><tr><th>کالا</th><th>تعداد رسید</th><th>مطالبه اولیه</th><th>تخصیص</th><th>مانده</th><th>پوشش</th></tr></thead><tbody>@foreach(var x in Model.Parts.Take(20)){<tr><td class="fw-bold">@x.Title</td><td>@x.Count</td><td>@x.Original.ToString("N0")</td><td>@x.Allocated.ToString("N0")</td><td class="amount-emphasis">@x.Remaining.ToString("N0")</td><td>@(x.Coverage*100m).ToString("0.0")٪</td></tr>}</tbody></table></div></div></div>
 <div class="col-xl-5"><div class="form-panel"><div class="panel-title"><div><h4>آخرین محاسبات تاییدشده</h4><span>برای ورود به جزئیات، روی شماره نوبت کلیک کنید.</span></div></div><div class="recent-runs">@foreach(var x in Model.Recent){<a href="/PaymentWizard/Details/@x.Id" class="recent-run"><span>#@x.Id</span><div><b>@x.Title</b><small>@x.Date · @x.Count رسید</small></div><strong>@x.Allocated.ToString("N0")</strong></a>}</div></div></div>
</div>

<div class="form-panel mt-3"><div class="panel-title"><div><h4>گزارش تامین‌کنندگان</h4><span>کلیه تامین‌کنندگان دارای سابقه تخصیص، مرتب‌شده بر اساس مانده مطالبات</span></div></div>
<div class="table-responsive"><table class="table modern-table"><thead><tr><th>تامین‌کننده</th><th>رسید</th><th>مطالبه اولیه</th><th>تخصیص تاکنون</th><th>مانده</th><th>پوشش</th><th>شاخص اولویت</th></tr></thead><tbody>@foreach(var x in Model.Suppliers.OrderByDescending(x=>x.Remaining)){<tr><td class="fw-bold">@x.Title</td><td>@x.Count</td><td>@x.Original.ToString("N0")</td><td>@x.Allocated.ToString("N0")</td><td class="amount-emphasis">@x.Remaining.ToString("N0")</td><td>@(x.Coverage*100m).ToString("0.0")٪</td><td><span class="priority-pill">@x.Priority</span></td></tr>}</tbody></table></div></div>

<div class="form-panel mt-3"><div class="panel-title"><div><h4>گزارش کالاها</h4><span>تخصیص و مطالبات باقیمانده به تفکیک کالا</span></div></div>
<div class="table-responsive"><table class="table modern-table"><thead><tr><th>کالا</th><th>رسید</th><th>مطالبه اولیه</th><th>تخصیص تاکنون</th><th>مانده</th><th>پوشش</th><th>رسید سررسیدگذشته</th><th>شاخص</th></tr></thead><tbody>@foreach(var x in Model.Parts.OrderByDescending(x=>x.Remaining)){<tr><td class="fw-bold">@x.Title</td><td>@x.Count</td><td>@x.Original.ToString("N0")</td><td>@x.Allocated.ToString("N0")</td><td class="amount-emphasis">@x.Remaining.ToString("N0")</td><td>@(x.Coverage*100m).ToString("0.0")٪</td><td>@x.Overdue</td><td><span class="priority-pill">@x.Priority</span></td></tr>}</tbody></table></div></div>