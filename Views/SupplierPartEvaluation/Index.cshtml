@model Indamin.Payment.Controllers.SupplierPartEvaluationController.EvaluatorVm
@using Indamin.Payment.Data
@{
    ViewData["Title"] = "ارزیابی قطعه–تامین‌کننده";
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));
}
<div class="page-header">
    <div>
        <div class="eyebrow">ارزیابی</div>
        <h2>ارزیابی پارامترهای قطعه–تامین‌کننده</h2>
        <p class="text-muted">امتیازهای شما برای هر قطعه–تامین‌کننده به‌صورت مستقل ثبت می‌شود و میانگین امتیاز ارزیابان، مبنای محاسبه پرداخت خواهد بود.</p>
    </div>
</div>

@if (Model.Parameters.Count == 0)
{
    <div class="alert alert-warning">هیچ پارامتر پرداخت Manual که برای کاربر شما قابل ارزیابی باشد فعال نیست. مدیر سامانه باید دسترسی پارامترهای موردنظر را در بخش نقش‌ها و دسترسی‌ها فعال کند.</div>
}
else
{
    <div class="info-box mb-3">
        <b>راهنمای امتیازدهی:</b> فقط پارامترهایی که دسترسی آن‌ها برای نقش شما فعال است نمایش داده می‌شوند. هر مقدار بین ۱ تا حداکثر امتیاز همان پارامتر ثبت می‌شود. میانگین همه ارزیابان در جدول فعلی ارزیابی قطعه–تامین‌کننده قرار می‌گیرد.
    </div>

    <section class="score-guide-library mb-3" aria-labelledby="scoreGuideLibraryTitle">
        <div class="score-guide-library-heading">
            <div>
                <h3 id="scoreGuideLibraryTitle"><span aria-hidden="true">▤</span> راهنمای پارامترهای ارزیابی</h3>
                <p>برای مشاهده روش امتیازدهی، روی عنوان هر پارامتر کلیک کنید. پنل راهنما در همین صفحه باز می‌شود.</p>
            </div>
            <span class="score-guide-hint" aria-hidden="true">ⓘ راهنما</span>
        </div>
        <div class="score-guide-buttons" role="group" aria-label="انتخاب پارامتر برای مشاهده راهنمای امتیازدهی">
            @foreach (var p in Model.Parameters)
            {
                var guideIcon = p.Type switch
                {
                    PaymentParameterType.Time => "◷",
                    PaymentParameterType.Financial => "◈",
                    PaymentParameterType.Part => "◆",
                    PaymentParameterType.Supplier => "♙",
                    _ => "ⓘ"
                };
                <button type="button" class="score-guide-button"
                        data-score-guide-button
                        data-guide-id="@p.Id"
                        data-guide-title="@p.Title"
                        data-guide-text="@p.ScoringGuide"
                        data-guide-weight="@p.Weight.ToString("0.##")"
                        data-guide-max="@p.MaxScore.ToString("0.##")"
                        data-guide-icon="@guideIcon"
                        aria-expanded="false"
                        aria-controls="scoreGuidePanel">
                    <span class="score-guide-button-icon" aria-hidden="true">@guideIcon</span>
                    <span class="score-guide-button-title">@p.Title</span>
                    <span class="score-guide-button-arrow" aria-hidden="true">⌄</span>
                </button>
            }
        </div>
        <div id="scoreGuidePanel" class="score-guide-panel" hidden>
            <div class="score-guide-panel-heading">
                <div class="score-guide-panel-title">
                    <span id="scoreGuidePanelIcon" class="score-guide-button-icon" aria-hidden="true">ⓘ</span>
                    <div>
                        <strong id="scoreGuidePanelTitle"></strong>
                        <div id="scoreGuidePanelMeta" class="score-guide-panel-meta"></div>
                    </div>
                </div>
                <button type="button" id="scoreGuidePanelClose" class="score-guide-close" aria-label="بستن راهنمای امتیازدهی">×</button>
            </div>
            <div id="scoreGuidePanelText" class="score-guide-panel-text"></div>
        </div>
    </section>

    <div class="table-panel">
        <form class="toolbar" method="get" action="/SupplierPartEvaluation">
            <input class="form-control" name="q" value="@Model.Search" placeholder="جست‌وجوی تامین‌کننده، کد قطعه یا عنوان قطعه...">
            <select class="form-select page-size-select" name="pageSize" onchange="this.form.submit()">
                <option value="25" selected="@(Model.PageSize==25)">25 ردیف</option>
                <option value="50" selected="@(Model.PageSize==50)">50 ردیف</option>
                <option value="75" selected="@(Model.PageSize==75)">75 ردیف</option>
                <option value="100" selected="@(Model.PageSize==100)">100 ردیف</option>
            </select>
            <button class="btn btn-outline-primary" type="submit">جست‌وجو</button>
        </form>

        @await Html.PartialAsync("_TablePagination", (Model.Page, totalPages, Model.PageSize, Model.Search ?? "", "/SupplierPartEvaluation"))

        <div class="table-responsive table-scroll">
            <table class="table modern-table align-middle">
                <thead>
                    <tr>
                        <th>تامین‌کننده</th>
                        <th>قطعه</th>
                        @foreach (var p in Model.Parameters)
                        {
                            <th class="text-center">
                                @p.Title
                                <br><span class="subtle">حداکثر @p.MaxScore:0.##</span>
                            </th>
                        }
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model.Mappings)
                {
                    var formId = $"assess-form-{m.Id}";
                    <tr>
                        <td class="fw-bold">@m.Supplier?.Code - @m.Supplier?.Title</td>
                        <td>@m.Part?.Code - @m.Part?.Title</td>
                        @{
                            var parameterIndex = 0;
                        }
                        @foreach (var p in Model.Parameters)
                        {
                            var mine = Model.MyScores.FirstOrDefault(x => x.SupplierPartId == m.Id && x.PaymentParameterId == p.Id);
                            var avgScores = Model.AllScores.Where(x => x.SupplierPartId == m.Id && x.PaymentParameterId == p.Id).Select(x => x.Score).ToList();
                            var average = avgScores.Count == 0 ? 1m : Math.Round(avgScores.Average(), 2);
                            <td class="score-cell">
                                <input form="@formId" class="form-control score-select" type="number" min="1" max="@p.MaxScore" step="0.1" name="items[@parameterIndex].Score" value="@(mine?.Score.ToString("0.##") ?? "")" placeholder="امتیاز">
                                <input form="@formId" type="hidden" name="items[@parameterIndex].ParameterId" value="@p.Id">
                                <small class="subtle d-block mt-1">میانگین: @average.ToString("0.##")</small>
                            </td>
                            parameterIndex++;
                        }
                        <td class="text-nowrap">
                            <form id="@formId" method="post" action="/SupplierPartEvaluation/Save">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="supplierPartId" value="@m.Id">
                                <input type="hidden" name="q" value="@Model.Search">
                                <input type="hidden" name="page" value="@Model.Page">
                                <input type="hidden" name="pageSize" value="@Model.PageSize">
                            </form>
                            <button form="@formId" class="btn btn-sm btn-main">ثبت امتیازها</button>
                        </td>
                    </tr>
                }
                @if (Model.Mappings.Count == 0)
                {
                    <tr><td colspan="@(Model.Parameters.Count + 3)" class="text-center text-muted py-4">موردی برای ارزیابی پیدا نشد.</td></tr>
                }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_TablePagination", (Model.Page, totalPages, Model.PageSize, Model.Search ?? "", "/SupplierPartEvaluation"))
    </div>
}
<script>
document.addEventListener("DOMContentLoaded",function(){
    const token=document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    if(!token) return;
    const ping=function(){
        fetch("/Account/PingEvaluatorActivity",{
            method:"POST",
            headers:{"RequestVerificationToken":token}
        }).catch(()=>{});
    };
    ping();
    window.setInterval(ping,60000);
});
</script>


<script>
document.addEventListener("DOMContentLoaded", function () {
    const buttons = Array.from(document.querySelectorAll("[data-score-guide-button]"));
    const panel = document.getElementById("scoreGuidePanel");
    if (!buttons.length || !panel) return;

    const panelIcon = document.getElementById("scoreGuidePanelIcon");
    const panelTitle = document.getElementById("scoreGuidePanelTitle");
    const panelMeta = document.getElementById("scoreGuidePanelMeta");
    const panelText = document.getElementById("scoreGuidePanelText");
    const closeButton = document.getElementById("scoreGuidePanelClose");

    function closePanel() {
        panel.hidden = true;
        buttons.forEach(button => {
            button.setAttribute("aria-expanded", "false");
            button.classList.remove("is-selected");
        });
    }

    buttons.forEach(button => button.addEventListener("click", function () {
        if (button.getAttribute("aria-expanded") === "true") {
            closePanel();
            return;
        }

        buttons.forEach(item => {
            item.setAttribute("aria-expanded", "false");
            item.classList.remove("is-selected");
        });

        panelIcon.textContent = button.dataset.guideIcon || "ⓘ";
        panelTitle.textContent = button.dataset.guideTitle || "راهنمای امتیازدهی";
        panelMeta.textContent = "وزن: " + (button.dataset.guideWeight || "۰") + "٪  |  حداکثر امتیاز: " + (button.dataset.guideMax || "۵");
        const guideText = (button.dataset.guideText || "").trim().replace(/\s*\|\s*/g, "\n");
        panelText.textContent = guideText || "برای این پارامتر هنوز راهنمای امتیازدهی ثبت نشده است.";
        panel.hidden = false;
        button.setAttribute("aria-expanded", "true");
        button.classList.add("is-selected");
    }));

    closeButton?.addEventListener("click", closePanel);
});
</script>

