@model List<Indamin.Payment.Data.PaymentRun>
@{ViewData["Title"]="محاسبات حذف‌شده";}
<div class="page-header"><div><div class="eyebrow">تاریخچه و بایگانی</div><h2>محاسبات حذف‌شده</h2><p class="text-muted">این رکوردها حذف فیزیکی نشده‌اند تا سابقه حسابرسی حفظ شود. تخصیص‌های آن‌ها در محاسبات جدید به‌عنوان پرداخت فعال در نظر گرفته نمی‌شوند.</p></div><a class="btn btn-outline-primary" href="/PaymentWizard/History">← بازگشت به سوابق فعال</a></div>
<div class="alert app-alert app-alert-warn"><span class="alert-icon">!</span><span>محاسبه‌های حذف‌شده دیگر در مانده بدهی رسیدها اثر ندارند و قابل بازگردانی یا صدور دستور پرداخت نیستند.</span></div>
<div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#deletedRuns" placeholder="جست‌وجوی عنوان، شماره یا تاریخ..."></div><div class="table-responsive"><table id="deletedRuns" class="table modern-table"><thead><tr><th>شماره</th><th>عنوان</th><th>تاریخ محاسبه</th><th>بودجه</th><th>تخصیص حذف‌شده</th><th>تعداد رسید</th><th>تاریخ حذف</th><th>عملیات</th></tr></thead><tbody>
@foreach(var r in Model){<tr><td>#@r.Id</td><td class="fw-bold">@r.Title</td><td>@r.CalculationDateJalali</td><td>@r.TotalAllocationBudget.ToString("N0") @r.AmountUnit</td><td>@r.Invoices.Sum(x=>x.AllocatedAmount).ToString("N0")</td><td>@r.Invoices.Count</td><td>@(r.DeletedAt.HasValue? r.DeletedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm"):"-")</td><td><a class="btn btn-sm btn-outline-primary" href="/PaymentWizard/Details/@r.Id">جزئیات سابقه</a><a class="btn btn-sm btn-outline-secondary" href="/PaymentWizard/ExportRun/@r.Id">Excel</a></td></tr>}
</tbody></table></div></div>