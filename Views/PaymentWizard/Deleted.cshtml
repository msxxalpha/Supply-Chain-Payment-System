@model List<Indamin.Payment.Data.PaymentRun>
@using Indamin.Payment.Data
@{ViewData["Title"]="پرداخت‌های حذف‌شده";}
<div class="page-header"><div><div class="eyebrow">تاریخچه و بایگانی</div><h2>پرداخت‌های حذف‌شده</h2><p class="text-muted">حذف به‌صورت منطقی انجام می‌شود؛ جزئیات و Snapshot برای حسابرسی حفظ می‌شوند و آثار مطالبات استقراری در حذف تراکنشی برگشت داده شده‌اند.</p></div><a class="btn btn-outline-primary" href="/PaymentWizard/History">← بازگشت به سوابق فعال</a></div>
<div class="alert app-alert app-alert-warn"><span class="alert-icon">!</span><span>پرداخت‌های حذف‌شده در مانده محاسبات فعال بعدی لحاظ نمی‌شوند و قابل صدور دستور پرداخت نیستند.</span></div>
<div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#deletedRuns" placeholder="جست‌وجوی عنوان، شماره، نوع یا تاریخ..."></div><div class="table-responsive"><table id="deletedRuns" class="table modern-table"><thead><tr><th>شماره</th><th>نوع</th><th>عنوان</th><th>تاریخ</th><th>مبلغ تخصیص</th><th>استقراری</th><th>جاری</th><th>تامین‌کننده</th><th>تاریخ حذف</th><th>عملیات</th></tr></thead><tbody>
@foreach(var r in Model){var initial=r.SupplierSummaries.Sum(x=>x.InitialClaimAllocatedAmount);var current=r.SupplierSummaries.Sum(x=>x.CurrentClaimAllocatedAmount);var total=r.SupplierSummaries.Sum(x=>x.AllocatedAmount);<tr><td>#@r.Id</td><td>@(r.RunType==PaymentRunType.NonCalculated?"غیرمحاسباتی":"محاسباتی")</td><td class="fw-bold">@r.Title</td><td>@r.CalculationDateJalali</td><td class="amount-emphasis">@total.ToString("N0")</td><td>@initial.ToString("N0")</td><td>@current.ToString("N0")</td><td>@r.SupplierSummaries.Count</td><td>@(r.DeletedAt.HasValue?r.DeletedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm"):"-")</td><td><a class="btn btn-sm btn-outline-primary" href="/PaymentWizard/Details/@r.Id">جزئیات سابقه</a><a class="btn btn-sm btn-outline-secondary" href="/PaymentWizard/ExportRun/@r.Id">Excel</a></td></tr>}
</tbody></table></div></div>