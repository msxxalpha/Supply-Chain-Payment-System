@model Indamin.Payment.Data.PaymentWizardState
@{ViewData["Title"]="گام اول؛ تعریف محاسبه";}
<div class="wizard-steps"><div class="wizard-step active"><span class="num">۱</span><div><b>تنظیمات محاسبه</b><small>تاریخ، بازه و بودجه</small></div></div><div class="wizard-step"><span class="num">۲</span><div><b>جذب و محاسبه</b><small>Excel، امتیاز و تخصیص</small></div></div><div class="wizard-step"><span class="num">۳</span><div><b>تجمیع و تایید</b><small>خلاصه تامین‌کنندگان</small></div></div></div>
<div class="page-header"><div><div class="eyebrow">ویزارد تخصیص پرداخت</div><h2>تعریف دوره محاسبه</h2><p class="text-muted">اطلاعات اولیه این نوبت پرداخت را ثبت کنید. تاریخ‌ها با تقویم شمسی هستند.</p></div></div>
<form method="post" class="form-panel">
@Html.AntiForgeryToken()
<div class="row g-3"><div class="col-lg-6"><label class="form-label">عنوان محاسبه</label><input class="form-control" name="Title" value="@Model.Title" required></div><div class="col-lg-3"><label class="form-label">مبلغ کل قابل تخصیص</label><input class="form-control" type="number" min="0" step="0.01" name="TotalAllocationBudget" value="@Model.TotalAllocationBudget" required></div><div class="col-lg-3"><label class="form-label">واحد مبلغ</label><input class="form-control" name="AmountUnit" value="@Model.AmountUnit"></div>
<div class="col-lg-4"><label class="form-label">تاریخ محاسبه</label><div class="jalali-input"><input type="text" class="form-control" data-jalali-date autocomplete="off" name="CalculationDateJalali" value="@Model.CalculationDateJalali" required><button class="date-trigger" type="button" data-jalali-trigger>▣</button></div></div>
<div class="col-lg-4"><label class="form-label">از تاریخ رسید</label><div class="jalali-input"><input type="text" class="form-control" data-jalali-date autocomplete="off" name="PeriodFromJalali" value="@Model.PeriodFromJalali" required><button class="date-trigger" type="button" data-jalali-trigger>▣</button></div></div>
<div class="col-lg-4"><label class="form-label">تا تاریخ رسید</label><div class="jalali-input"><input type="text" class="form-control" data-jalali-date autocomplete="off" name="PeriodToJalali" value="@Model.PeriodToJalali" required><button class="date-trigger" type="button" data-jalali-trigger>▣</button></div></div>
<div class="col-12"><label class="form-label">توضیحات</label><textarea class="form-control" name="Notes" rows="3">@Model.Notes</textarea></div></div>
<div class="info-box mt-3"><b>منطق تخصیص:</b> ابتدا امتیاز وزنی هر رسید از مجموع «امتیاز × وزن ÷ ۱۰۰» به‌دست می‌آید. سپس بودجه بین رسیدهای دارای مانده بدهی متناسب با امتیاز وزنی توزیع و حداکثر تا سقف مانده همان رسید تخصیص داده می‌شود؛ در نتیجه مجموع تخصیص از بودجه و از مانده بدهی بیشتر نخواهد شد.</div>
<div class="step-actions"><span class="subtle">اطلاعات در نشست موقت کاربر نگهداری می‌شود تا مرحله تایید.</span><button class="btn btn-main btn-lg">ادامه به جذب Excel ←</button></div></form>