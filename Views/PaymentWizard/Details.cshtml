@model Indamin.Payment.Data.PaymentRun
@using Indamin.Payment.Data
@{ViewData["Title"]=$"جزئیات پرداخت شماره {Model.Id}";var initial=Model.SupplierSummaries.Sum(x=>x.InitialClaimAllocatedAmount);var current=Model.SupplierSummaries.Sum(x=>x.CurrentClaimAllocatedAmount);var total=Model.SupplierSummaries.Sum(x=>x.AllocatedAmount);}
<div class="page-header"><div><div class="eyebrow">جزئیات پرداخت</div><h2>@Model.Title</h2><p class="text-muted">شماره @Model.Id — نوع: @(Model.RunType==PaymentRunType.NonCalculated?"پرداخت غیرمحاسباتی":"پرداخت محاسباتی") — منبع: @(Model.ReceiptSource==PaymentReceiptSource.WarehouseSubsystem?"زیرسیستم انبار":"Excel") — تاریخ: @Model.CalculationDateJalali — وضعیت: @(Model.IsDeleted?"حذف‌شده":Model.Status==PaymentRunStatus.PaymentOrdered?"دستور پرداخت شده":"تایید شده") @if(Model.PaymentOrderNumber!=null){<span>— @Model.PaymentOrderNumber</span>}</p></div><div class="export-group"><a class="btn btn-outline-primary" href="/PaymentWizard/ExportRun/@Model.Id">خروجی Excel</a><a class="btn btn-outline-secondary" href="/PaymentWizard/ExportSummary/@Model.Id">خلاصه تامین‌کنندگان</a>@if(Model.Status==PaymentRunStatus.PaymentOrdered&&!Model.IsDeleted&&User.HasClaim("Permission","Payment.OrderDownload")){<a class="btn btn-main" href="/PaymentWizard/DownloadPaymentOrder/@Model.Id">دریافت دستور پرداخت PDF</a>}</div></div>
@if(Model.IsDeleted){<div class="alert app-alert app-alert-warn mb-3"><span class="alert-icon">!</span><span>این پرداخت به‌صورت منطقی حذف شده و در محاسبات فعال بعدی لحاظ نمی‌شود.</span></div>}
<div class="payment-kpi-grid"><div class="payment-kpi"><span>تخصیص استقراری</span><strong>@initial.ToString("N0")</strong><small>کاهش/برگشت در موجودی مطالبات استقراری</small></div><div class="payment-kpi"><span>تخصیص جاری</span><strong>@current.ToString("N0")</strong><small>کاهش مانده رسیدهای جاری</small></div><div class="payment-kpi"><span>مجموع تخصیص</span><strong>@total.ToString("N0")</strong><small>ریال</small></div><div class="payment-kpi"><span>تامین‌کنندگان</span><strong>@Model.SupplierSummaries.Count</strong><small>@Model.Invoices.Count رسید snapshot</small></div></div>
<div class="table-panel mb-3"><div class="panel-title"><div><h4>خلاصه تامین‌کنندگان</h4><span>Snapshot ثبت‌شده در زمان تایید</span></div></div><div class="table-responsive"><table class="table modern-table"><thead><tr><th>تامین‌کننده</th><th>تعداد رسید</th><th>مطالبات استقراری قبل</th><th>تخصیص استقراری</th><th>تخصیص جاری</th><th>مجموع تخصیص</th><th>مطالبات استقراری بعد</th><th>نوع پرداخت</th><th>درخواست</th></tr></thead><tbody>@foreach(var x in Model.SupplierSummaries.OrderByDescending(x=>x.AllocatedAmount)){<tr><td class="fw-bold">@x.SupplierTitle</td><td>@x.InvoiceCount</td><td>@x.InitialClaimBefore.ToString("N0")</td><td>@x.InitialClaimAllocatedAmount.ToString("N0")</td><td>@x.CurrentClaimAllocatedAmount.ToString("N0")</td><td class="amount-emphasis">@x.AllocatedAmount.ToString("N0")</td><td>@x.InitialClaimAfter.ToString("N0")</td><td>@(x.PaymentType.HasValue?(x.PaymentType==NonCalculatedPaymentType.Cash?"نقدی":x.PaymentType==NonCalculatedPaymentType.CheckTransfer?"واگذاری چک":x.PaymentType==NonCalculatedPaymentType.VehicleTransfer?"واگذاری خودرو":x.PaymentType==NonCalculatedPaymentType.RawMaterialTransfer?"واگذاری مواداولیه":x.PaymentType==NonCalculatedPaymentType.IntroductionLetter?"معرفی نامه":"حد اعتباری"):"—")</td><td>@x.RequestedAmount.ToString("N0")</td></tr>}</tbody></table></div></div>
<div class="table-panel mb-3">
<div class="panel-title"><div><h4>Snapshot اقلام پرداخت غیرمحاسباتی</h4><span>ثبت‌شده هنگام صدور دستور پرداخت؛ شامل تامین‌کننده تکراری، نوع پرداخت، مبلغ و توضیحات هر آیتم</span></div></div>
<div class="table-responsive"><table class="table modern-table"><thead><tr><th>ردیف</th><th>تامین‌کننده</th><th>نوع پرداخت</th><th>مبلغ درخواست</th><th>سهم استقراری</th><th>سهم جاری</th><th>مجموع تخصیص</th><th>توضیحات</th><th>تاریخ</th></tr></thead><tbody>
@if(Model.NonCalculatedPaymentLines.Count==0)
{
 <tr><td colspan="9" class="text-center text-muted py-3">برای این پرداخت آیتم غیرمحاسباتی ثبت نشده است.</td></tr>
}
else
{
 @foreach(var x in Model.NonCalculatedPaymentLines.OrderBy(x=>x.LineNumber))
 {
  <tr><td>@x.LineNumber</td><td class="fw-bold">@x.SupplierTitleSnapshot</td><td>@PaymentTypeTitle(x.PaymentType)</td><td>@x.RequestedAmount.ToString("N0")</td><td>@x.InitialClaimAllocatedAmount.ToString("N0")</td><td>@x.CurrentClaimAllocatedAmount.ToString("N0")</td><td class="amount-emphasis">@x.AllocatedAmount.ToString("N0")</td><td>@(string.IsNullOrWhiteSpace(x.Description)?"—":x.Description)</td><td>@x.PaymentDateJalali</td></tr>
 }
}
</tbody></table></div></div><div class="table-panel mb-3"><div class="panel-title"><div><h4>Snapshot پارامترهای سیستم</h4><span>مقادیر مؤثر در زمان ثبت این پرداخت</span></div></div><div class="table-responsive"><table class="table modern-table"><thead><tr><th>کد</th><th>عنوان</th><th>مقدار</th><th>واحد</th></tr></thead><tbody>@foreach(var x in Model.SystemParameterSnapshots.OrderBy(x=>x.Id)){<tr><td>@x.Code</td><td class="fw-bold">@x.Title</td><td>@(x.Code=="CURRENT_CLAIM_CALC_METHOD" ? (x.Value==2 ? "تعدادی بر اساس فهرست بها" : "دریافت اطلاعات ریالی") : x.Value.ToString("N2"))</td><td>@x.Unit</td></tr>}</tbody></table></div></div>
<div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#details" placeholder="جست‌وجوی رسید، انبار، کالا یا تامین‌کننده..."></div><div class="table-responsive table-scroll"><table id="details" class="table modern-table sticky-header"><thead><tr><th>رسید</th><th>انبار</th><th>کالا</th><th>تامین‌کننده</th><th>مقدار رسید</th><th>روش بدهی</th><th>نرخ فهرست بها</th><th>بدهی اولیه</th><th>تخصیص قبلی جاری</th><th>مانده جاری</th><th>تخصیص جاری</th><th>تخصیص استقراری</th><th>مجموع تخصیص</th></tr></thead><tbody>@foreach(var x in Model.Invoices){<tr><td>@x.ReceiptNo</td><td>@x.Warehouse</td><td>@x.PartTitle</td><td>@x.SupplierTitle</td><td>@x.ReceiptQuantity.ToString("N3")</td><td>@(x.DebtCalculationMethod==CurrentClaimCalculationMethod.QuantityBasedPriceList?"تعدادی / فهرست بها":"ریالی")</td><td>@(x.AppliedUnitPrice>0?x.AppliedUnitPrice.ToString("N0"):"—")</td><td>@x.OriginalDebt.ToString("N0")</td><td>@x.PreviousAllocated.ToString("N0")</td><td>@x.RemainingDebt.ToString("N0")</td><td>@x.AllocatedCurrentAmount.ToString("N0")</td><td>@x.AllocatedInitialClaimAmount.ToString("N0")</td><td class="amount-emphasis">@x.AllocatedAmount.ToString("N0")</td></tr>}</tbody></table></div></div>
@functions { string PaymentTypeTitle(NonCalculatedPaymentType type) => type switch { NonCalculatedPaymentType.Cash=>"نقدی", NonCalculatedPaymentType.CheckTransfer=>"واگذاری چک", NonCalculatedPaymentType.VehicleTransfer=>"واگذاری خودرو", NonCalculatedPaymentType.RawMaterialTransfer=>"واگذاری مواداولیه", NonCalculatedPaymentType.IntroductionLetter=>"معرفی نامه", NonCalculatedPaymentType.CreditLimit=>"حد اعتباری", _=>"نامشخص" }; }
