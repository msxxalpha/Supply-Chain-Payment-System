@model Indamin.Payment.Data.PaymentRun
@{ViewData["Title"]=$"جزئیات تخصیص شماره {Model.Id}";}
<div class="page-header"><div><div class="eyebrow">جزئیات نوبت پرداخت</div><h2>@Model.Title</h2><p class="text-muted">شماره @Model.Id — @Model.CalculationDateJalali — وضعیت: @Model.Status</p></div><div class="export-group"><a class="btn btn-outline-primary" href="/PaymentWizard/ExportRun/@Model.Id">خروجی Excel</a><a class="btn btn-outline-secondary" href="/PaymentWizard/ExportSummary/@Model.Id">خلاصه تامین‌کنندگان</a></div></div>
<div class="payment-kpi-grid"><div class="payment-kpi"><span>بودجه</span><strong>@Model.TotalAllocationBudget.ToString("N0")</strong><small>@Model.AmountUnit</small></div><div class="payment-kpi"><span>بدهی جذب‌شده</span><strong>@Model.ImportedDebt.ToString("N0")</strong><small>@Model.Invoices.Count رسید</small></div><div class="payment-kpi"><span>مانده قابل پرداخت در محاسبه</span><strong>@Model.RemainingDebt.ToString("N0")</strong><small>پس از تخصیص‌های قبلی</small></div><div class="payment-kpi"><span>تخصیص تاییدشده</span><strong>@Model.Invoices.Sum(x=>x.AllocatedAmount).ToString("N0")</strong><small>سقف عدم پرداخت مازاد رعایت شده</small></div></div>
<div class="table-panel mb-3"><div class="panel-title"><div><h4>خلاصه ثبت‌شده تامین‌کنندگان</h4><span>snapshot ذخیره‌شده در زمان تایید</span></div></div><div class="table-responsive"><table class="table modern-table"><thead><tr><th>تامین‌کننده</th><th>تعداد رسید</th><th>مانده بدهی</th><th>مبلغ تخصیص‌یافته</th><th>سهم</th></tr></thead><tbody>@foreach(var x in Model.SupplierSummaries.OrderByDescending(x=>x.AllocatedAmount)){<tr><td class="fw-bold">@x.SupplierTitle</td><td>@x.InvoiceCount</td><td>@x.RemainingDebt.ToString("N0")</td><td class="amount-emphasis">@x.AllocatedAmount.ToString("N0")</td><td>@(x.AllocationPercent*100m).ToString("0.00")٪</td></tr>}</tbody></table></div></div><div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#details" placeholder="جست‌وجوی رسید، انبار، کالا یا تامین‌کننده..."></div><div class="table-responsive table-scroll"><table id="details" class="table modern-table sticky-header"><thead><tr><th>رسید</th><th>انبار</th><th>کالا</th><th>تامین‌کننده</th><th>بدهی</th><th>تخصیص قبلی</th><th>مانده</th><th>مانده بدهی تامین‌کننده</th><th>امتیاز وزنی</th><th>تخصیص مرحله دوم</th><th>تخصیص نهایی</th></tr></thead><tbody>@foreach(var x in Model.Invoices){<tr><td>@x.ReceiptNo</td><td>@x.Warehouse</td><td>@x.PartTitle</td><td>@x.SupplierTitle</td><td>@x.OriginalDebt.ToString("N0")</td><td>@x.PreviousAllocated.ToString("N0")</td><td>@x.RemainingDebt.ToString("N0")</td><td>@x.SupplierOutstandingDebt.ToString("N0")</td><td>@x.WeightedScore.ToString("0.000")</td><td>@x.CalculatedAllocatedAmount.ToString("N0")</td><td class="amount-emphasis">@x.AllocatedAmount.ToString("N0")</td></tr>}</tbody></table></div></div>