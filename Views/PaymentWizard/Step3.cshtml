@model Indamin.Payment.Data.PaymentWizardState
@{
 ViewData["Title"]="گام سوم؛ تجمیع و تایید تخصیص";
 var groups=Model.Rows.Where(x=>x.SupplierId.HasValue).GroupBy(x=>new{x.SupplierId,x.SupplierTitle}).Select(g=>new{SupplierId=g.Key.SupplierId!.Value,Supplier=g.Key.SupplierTitle,Amount=g.Sum(x=>x.AllocatedAmount),Calculated=g.Sum(x=>x.CalculatedAllocatedAmount),Debt=g.Sum(x=>x.RemainingDebt),Count=g.Count()}).OrderByDescending(x=>x.Amount).ThenBy(x=>x.Supplier).ToList();
 var total=groups.Sum(x=>x.Amount);var calculatedTotal=groups.Sum(x=>x.Calculated);var remainingBudget=Math.Max(0,Model.TotalAllocationBudget-total);
}
<div class="wizard-steps"><div class="wizard-step done"><span class="num">✓</span><div><b>تنظیمات محاسبه</b><small>تکمیل شد</small></div></div><div class="wizard-step done"><span class="num">✓</span><div><b>جذب و محاسبه</b><small>@Model.Rows.Count رسید</small></div></div><div class="wizard-step active"><span class="num">۳</span><div><b>تجمیع و تایید</b><small>اصلاح سهم تامین‌کنندگان</small></div></div></div>
<div class="page-header"><div><div class="eyebrow">کنترل تخصیص قبل از پرداخت</div><h2>تجمیع تخصیص به تفکیک تامین‌کننده</h2><p class="text-muted">در این مرحله مبلغ کل تخصیص‌یافته به هر تامین‌کننده نمایش داده و قابل ویرایش است. جزئیات تک‌تک رسیدها در مرحله دوم و در ثبت نهایی snapshot نگهداری می‌شود.</p></div><a class="btn btn-outline-primary" href="/PaymentWizard/ExportPreview">Excel جزئیات رسیدها</a></div>
<div class="payment-kpi-grid"><div class="payment-kpi"><span>تعداد تامین‌کننده</span><strong>@groups.Count</strong><small>تجمیع شده از @Model.Rows.Count رسید</small></div><div class="payment-kpi"><span>بودجه</span><strong id="budget">@Model.TotalAllocationBudget.ToString("N0")</strong><small>@Model.AmountUnit</small></div><div class="payment-kpi"><span>تخصیص نهایی فعلی</span><strong id="allocationTotal">@total.ToString("N0")</strong><small id="allocationPercent">@(Model.TotalAllocationBudget>0?(total/Model.TotalAllocationBudget*100).ToString("0.00"):"0")٪ بودجه</small></div><div class="payment-kpi"><span>بودجه آزاد</span><strong id="freeBudget">@remainingBudget.ToString("N0")</strong><small id="budgetStatus">قابل استفاده برای افزایش سهم</small></div></div>
<div class="info-box mb-3"><b>روش اصلاح:</b> مبلغ نهایی هر تامین‌کننده را در جدول زیر تغییر دهید. هنگام ذخیره، سامانه مبلغ نهایی هر تامین‌کننده را به جزئیات رسیدهای همان تامین‌کننده تسهیم می‌کند؛ مبنای توزیع، تخصیص مرحله دوم و در صورت نیاز مانده بدهی رسیدهاست. سقف مانده بدهی هر رسید و سقف بودجه کل رعایت می‌شود.</div>
<form method="post" action="/PaymentWizard/UpdateSupplierAllocations" id="supplierAllocationForm">
@Html.AntiForgeryToken()
<div class="table-panel"><div class="panel-title"><div><h4>تخصیص نهایی به تفکیک تامین‌کننده</h4><span>فقط ستون «تخصیص نهایی» قابل ویرایش است.</span></div><button class="btn btn-main" type="submit">ذخیره تخصیص تامین‌کنندگان</button></div>
<div class="table-responsive"><table class="table modern-table align-middle"><thead><tr><th>ردیف</th><th>تامین‌کننده</th><th>تعداد رسید</th><th>مانده بدهی</th><th>تخصیص مرحله دوم</th><th>تخصیص نهایی قابل ویرایش</th><th>تغییر</th></tr></thead><tbody>
@for(var i=0;i<groups.Count;i++){var x=groups[i];<tr data-supplier-id="@x.SupplierId"><td>@(i+1)<input type="hidden" name="items[@i].SupplierId" value="@x.SupplierId"></td><td class="fw-bold">@x.Supplier</td><td>@x.Count</td><td>@x.Debt.ToString("N0")</td><td>@x.Calculated.ToString("N0")</td><td><input class="form-control supplier-allocation-input" data-initial="@x.Calculated.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-max="@x.Debt.ToString(System.Globalization.CultureInfo.InvariantCulture)" name="items[@i].Amount" value="@x.Amount.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="@x.Debt.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" step="0.01"></td><td class="supplier-delta">۰</td></tr>}
</tbody><tfoot><tr><th colspan="3">جمع</th><th>@groups.Sum(x=>x.Debt).ToString("N0")</th><th id="calculatedTotal">@calculatedTotal.ToString("N0")</th><th id="footerTotal">@total.ToString("N0")</th><th id="deltaTotal">۰</th></tr></table></div></div>
</form>
<div class="info-box mt-3"><b>نکته حسابرسی:</b> تغییر مبلغ تامین‌کننده باعث حذف جزئیات رسیدها نمی‌شود. در تایید نهایی، برای هر رسید هم «تخصیص مرحله دوم» و هم «تخصیص نهایی» ذخیره می‌شود و محاسبات بعدی همچنان بر اساس کلید رسید + انبار + کالا + تامین‌کننده و تخصیص‌های تاییدشده قبلی انجام خواهد شد.</div>
<div class="step-actions"><a class="btn btn-outline-secondary" href="/PaymentWizard/Step2">← بازگشت و اصلاح امتیازها</a><form method="post" action="/PaymentWizard/Approve" onsubmit="return confirm('آیا مبالغ نهایی تامین‌کنندگان در دیتابیس ثبت شوند؟');">@Html.AntiForgeryToken()<button class="btn btn-main btn-lg">تایید نهایی و ثبت پرداخت ✓</button></form></div>
<script>
(function(){
 const fmt=n=>new Intl.NumberFormat('fa-IR',{maximumFractionDigits:0}).format(Math.round(n));
 const inputs=[...document.querySelectorAll('.supplier-allocation-input')],budget=parseFloat('@Model.TotalAllocationBudget.ToString(System.Globalization.CultureInfo.InvariantCulture)');
 function refresh(){let total=0,initial=0;inputs.forEach(el=>{let v=parseFloat(el.value)||0,max=parseFloat(el.dataset.max)||0;v=Math.max(0,Math.min(v,max));el.value=v.toFixed(2);total+=v;initial+=parseFloat(el.dataset.initial)||0;const row=el.closest('tr'),delta=v-(parseFloat(el.dataset.initial)||0);row.querySelector('.supplier-delta').textContent=(delta>=0?'+':'')+fmt(delta);});document.getElementById('allocationTotal').textContent=fmt(total);document.getElementById('freeBudget').textContent=fmt(Math.max(0,budget-total));document.getElementById('allocationPercent').textContent=(budget>0?(total/budget*100).toFixed(2):'0')+'٪';document.getElementById('footerTotal').textContent=fmt(total);document.getElementById('deltaTotal').textContent=(total-initial>=0?'+':'')+fmt(total-initial);const status=document.getElementById('budgetStatus');if(total>budget+.005){status.textContent='جمع تخصیص از بودجه بیشتر است';status.classList.add('text-danger');}else{status.textContent='قابل استفاده برای افزایش سهم';status.classList.remove('text-danger');}}
 inputs.forEach(x=>x.addEventListener('input',refresh));refresh();document.getElementById('supplierAllocationForm').addEventListener('submit',e=>{const total=inputs.reduce((s,x)=>s+(parseFloat(x.value)||0),0);if(total>budget+.005){e.preventDefault();alert('جمع تخصیص تامین‌کنندگان نمی‌تواند از بودجه بیشتر باشد.');}});
})();
</script>