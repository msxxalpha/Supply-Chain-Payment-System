@model Indamin.Payment.Data.PaymentWizardState
@{ViewData["Title"]="گام سوم؛ تجمیع و تایید";var groups=Model.Rows.GroupBy(x=>x.SupplierTitle).Select(g=>new{Supplier=g.Key,Amount=g.Sum(x=>x.AllocatedAmount),Debt=g.Sum(x=>x.RemainingDebt),Count=g.Count(),Weighted=g.Sum(x=>x.AllocatedAmount*x.WeightedScore)}).OrderByDescending(x=>x.Amount).ToList();}
<div class="wizard-steps"><div class="wizard-step done"><span class="num">✓</span><div><b>تنظیمات محاسبه</b><small>تکمیل شد</small></div></div><div class="wizard-step done"><span class="num">✓</span><div><b>جذب و محاسبه</b><small>@Model.Rows.Count رسید</small></div></div><div class="wizard-step active"><span class="num">۳</span><div><b>تجمیع و تایید</b><small>ثبت نهایی در دیتابیس</small></div></div></div>
<div class="page-header"><div><div class="eyebrow">خلاصه تامین‌کنندگان</div><h2>مبلغ قابل تخصیص به هر تامین‌کننده</h2><p class="text-muted">پس از تایید، جدول خلاصه و جزئیات رسیدها به‌صورت یک نوبت پرداخت ثبت‌شده در پایگاه داده ذخیره می‌شود.</p></div><a class="btn btn-outline-primary" href="/PaymentWizard/ExportPreview">Excel جزئیات</a></div>
<div class="payment-kpi-grid"><div class="payment-kpi"><span>تامین‌کنندگان مشمول</span><strong>@groups.Count</strong><small>دارای مانده بدهی و تخصیص</small></div><div class="payment-kpi"><span>تعداد رسید</span><strong>@Model.Rows.Count</strong><small>پس از حذف رسیدهای صفرشده</small></div><div class="payment-kpi"><span>بودجه</span><strong>@Model.TotalAllocationBudget.ToString("N0")</strong><small>@Model.AmountUnit</small></div><div class="payment-kpi"><span>جمع تخصیص</span><strong>@Model.Rows.Sum(x=>x.AllocatedAmount).ToString("N0")</strong><small>نباید از بودجه بیشتر شود</small></div></div>
<div class="table-panel mb-3"><div class="panel-title"><div><h4>خلاصه تخصیص</h4><span>این جدول مبنای تایید نهایی است.</span></div></div><div class="table-responsive"><table class="table modern-table"><thead><tr><th>ردیف</th><th>تامین‌کننده</th><th>تعداد رسید</th><th>مانده بدهی</th><th>مبلغ قابل تخصیص</th><th>نسبت از کل</th></tr></thead><tbody>@for(var i=0;i<groups.Count;i++){var g=groups[i];<tr><td>@(i+1)</td><td class="fw-bold">@g.Supplier</td><td>@g.Count</td><td>@g.Debt.ToString("N0")</td><td class="amount-emphasis">@g.Amount.ToString("N0")</td><td>@(Model.Rows.Sum(x=>x.AllocatedAmount)>0?(g.Amount/Model.Rows.Sum(x=>x.AllocatedAmount)*100).ToString("0.00"):"0")٪</td></tr>}</tbody><tfoot><tr><th colspan="2">جمع</th><th>@groups.Sum(x=>x.Count)</th><th>@groups.Sum(x=>x.Debt).ToString("N0")</th><th class="summary-total">@groups.Sum(x=>x.Amount).ToString("N0")</th><th>۱۰۰٪</th></tr></tfoot></table></div></div>
<div class="info-box mb-3"><b>تایید مالی:</b> قبل از ثبت، سامانه تخصیص‌های تاییدشده قبلی را دوباره کنترل می‌کند. اگر سابقه پرداخت همان رسید از زمان محاسبه تا اکنون تغییر کرده باشد، ثبت متوقف می‌شود و باید محاسبه از ابتدا انجام شود. این کنترل برای جلوگیری از پرداخت مضاعف است.</div>
<div class="step-actions"><a class="btn btn-outline-secondary" href="/PaymentWizard/Step2">← بازگشت و اصلاح</a><form method="post" action="/PaymentWizard/Approve" onsubmit="return confirm('آیا جدول تخصیص و پرداخت به تامین‌کنندگان نهایی و در دیتابیس ثبت شود؟');">@Html.AntiForgeryToken()<button class="btn btn-main btn-lg">تایید نهایی و ثبت در دیتابیس ✓</button></form></div>