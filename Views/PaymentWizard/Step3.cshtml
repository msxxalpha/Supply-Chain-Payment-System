@model Indamin.Payment.Data.PaymentWizardState
@{ViewData["Title"]="گام سوم؛ کنترل و تایید تخصیص";var total=Model.Rows.Sum(x=>x.AllocatedAmount);var remainingBudget=Math.Max(0,Model.TotalAllocationBudget-total);var groups=Model.Rows.GroupBy(x=>x.SupplierTitle).Select(g=>new{Supplier=g.Key,Amount=g.Sum(x=>x.AllocatedAmount),Debt=g.Sum(x=>Math.Max(0,x.RemainingDebt-x.AllocatedAmount)),Count=g.Count()}).OrderByDescending(x=>x.Amount).ToList();}
<div class="wizard-steps"><div class="wizard-step done"><span class="num">✓</span><div><b>تنظیمات محاسبه</b><small>تکمیل شد</small></div></div><div class="wizard-step done"><span class="num">✓</span><div><b>جذب و محاسبه</b><small>@Model.Rows.Count رسید</small></div></div><div class="wizard-step active"><span class="num">۳</span><div><b>کنترل و تایید</b><small>اصلاح سهم قبل از ثبت نهایی</small></div></div></div>
<div class="page-header"><div><div class="eyebrow">کنترل تخصیص قبل از پرداخت</div><h2>اصلاح سهم تخصیص هر رسید</h2><p class="text-muted">مبلغ هر رسید قابل افزایش، کاهش یا صفر کردن است؛ حتی اگر در محاسبه اولیه سهمی دریافت نکرده باشد. جمع نهایی نباید از بودجه یا مانده همان رسید بیشتر شود.</p></div><a class="btn btn-outline-primary" href="/PaymentWizard/ExportPreview">Excel جزئیات</a></div>
<div class="payment-kpi-grid"><div class="payment-kpi"><span>تعداد رسید</span><strong>@Model.Rows.Count</strong><small>رسیدهای دارای مانده</small></div><div class="payment-kpi"><span>بودجه</span><strong id="budget">@Model.TotalAllocationBudget.ToString("N0")</strong><small>@Model.AmountUnit</small></div><div class="payment-kpi"><span>تخصیص فعلی</span><strong id="allocationTotal">@total.ToString("N0")</strong><small id="allocationPercent">@(Model.TotalAllocationBudget>0?(total/Model.TotalAllocationBudget*100).ToString("0.00"):"0")٪ بودجه</small></div><div class="payment-kpi"><span>بودجه آزاد</span><strong id="freeBudget">@remainingBudget.ToString("N0")</strong><small>قابل استفاده برای افزایش سهم</small></div></div>
<div class="info-box mb-3"><b>منطق کنترل:</b> محاسبه اولیه فقط نقطه شروع است. در این مرحله تصمیم‌گیر مالی می‌تواند سهم یک رسید را کم یا زیاد کند یا برای رسیدی که ابتدا صفر بوده مبلغ تعیین کند. سامانه سقف هر رسید را کنترل می‌کند و مبلغ اضافه‌شده به یک رسید از بودجه سایر رسیدها کم نمی‌کند مگر اینکه مجموع تخصیص از بودجه عبور کند؛ در آن حالت ذخیره اصلاحات متوقف می‌شود.</div>
<form method="post" action="/PaymentWizard/UpdateAllocations" id="allocationForm">
@Html.AntiForgeryToken()
<div class="table-panel mb-3"><div class="panel-title"><div><h4>جزئیات تخصیص قابل ویرایش</h4><span>مبلغ «تخصیص نهایی» مستقیماً مبنای ثبت پرداخت خواهد بود.</span></div><button class="btn btn-main" type="submit">ذخیره اصلاحات تخصیص</button></div>
<div class="table-responsive"><table class="table modern-table align-middle"><thead><tr><th>ردیف</th><th>تامین‌کننده</th><th>رسید</th><th>کالا</th><th>مانده بدهی</th><th>امتیاز وزنی</th><th>تخصیص اولیه</th><th>تخصیص نهایی</th><th>تغییر</th></tr></thead><tbody>
@for(var i=0;i<Model.Rows.Count;i++){var x=Model.Rows[i];<tr><td>@(i+1)<input type="hidden" name="items[@i].RowIndex" value="@i"></td><td class="fw-bold">@x.SupplierTitle</td><td>@x.ReceiptNo</td><td>@x.PartTitle</td><td>@x.RemainingDebt.ToString("N0")</td><td>@x.WeightedScore.ToString("0.000")</td><td class="initial-allocation">@x.AllocatedAmount.ToString("N0")</td><td><input class="form-control allocation-input" data-initial="@x.AllocatedAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-max="@x.RemainingDebt.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-index="@i" name="items[@i].Amount" value="@x.AllocatedAmount.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="@x.RemainingDebt.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" step="0.01"></td><td class="allocation-delta">۰</td></tr>}
</tbody><tfoot><tr><th colspan="4">جمع</th><th>@Model.Rows.Sum(x=>x.RemainingDebt).ToString("N0")</th><th></th><th id="initialTotal">@total.ToString("N0")</th><th id="footerTotal">@total.ToString("N0")</th><th id="deltaTotal">۰</th></tr></tfoot></table></div></div>
</form>
<div class="table-panel mb-3"><div class="panel-title"><div><h4>خلاصه تامین‌کنندگان</h4><span>این خلاصه با تغییر مبالغ بالا به‌صورت زنده محاسبه می‌شود.</span></div></div><div class="table-responsive"><table class="table modern-table"><thead><tr><th>تامین‌کننده</th><th>تعداد رسید</th><th>مانده پس از تخصیص</th><th>تخصیص نهایی</th><th>سهم از تخصیص</th></tr></thead><tbody id="supplierSummary">@foreach(var g in groups){<tr data-supplier="@g.Supplier"><td class="fw-bold">@g.Supplier</td><td>@g.Count</td><td class="supplier-debt">@g.Debt.ToString("N0")</td><td class="supplier-amount">@g.Amount.ToString("N0")</td><td class="supplier-percent">@(total>0?(g.Amount/total*100).ToString("0.00"):"0")٪</td></tr>}</tbody></table></div></div>
<div class="step-actions"><a class="btn btn-outline-secondary" href="/PaymentWizard/Step2">← بازگشت و اصلاح امتیازها</a><form method="post" action="/PaymentWizard/Approve" onsubmit="return confirm('آیا مبالغ اصلاح‌شده نهایی و در دیتابیس ثبت شوند؟');">@Html.AntiForgeryToken()<button class="btn btn-main btn-lg">تایید نهایی و ثبت پرداخت ✓</button></form></div>
<script>
(function(){
 const fmt=n=>new Intl.NumberFormat('fa-IR',{maximumFractionDigits:0}).format(Math.round(n));
 const inputs=[...document.querySelectorAll('.allocation-input')], budget=parseFloat('@Model.TotalAllocationBudget.ToString(System.Globalization.CultureInfo.InvariantCulture)');
 function refresh(){
  let total=0, initial=0;const suppliers={};
  inputs.forEach((el,i)=>{let v=parseFloat(el.value)||0,max=parseFloat(el.dataset.max)||0;v=Math.max(0,Math.min(v,max));el.value=v.toFixed(2);total+=v;initial+=parseFloat(el.dataset.initial)||0;const row=el.closest('tr'),delta=v-(parseFloat(el.dataset.initial)||0);row.querySelector('.allocation-delta').textContent=(delta>=0?'+':'')+fmt(delta);const supplier=row.children[1].innerText.trim();suppliers[supplier]??={count:0,amount:0,debt:0};suppliers[supplier].count++;suppliers[supplier].amount+=v;suppliers[supplier].debt+=max-v;});
  document.getElementById('allocationTotal').textContent=fmt(total);document.getElementById('freeBudget').textContent=fmt(Math.max(0,budget-total));document.getElementById('allocationPercent').textContent=(budget>0?(total/budget*100).toFixed(2):'0')+'٪';document.getElementById('footerTotal').textContent=fmt(total);document.getElementById('deltaTotal').textContent=(total-initial>=0?'+':'')+fmt(total-initial);
  document.querySelectorAll('#supplierSummary tr').forEach(tr=>{const d=suppliers[tr.dataset.supplier];if(!d)return;tr.querySelector('.supplier-debt').textContent=fmt(d.debt);tr.querySelector('.supplier-amount').textContent=fmt(d.amount);tr.querySelector('.supplier-percent').textContent=(total>0?(d.amount/total*100).toFixed(2):'0')+'٪';});
 }
 inputs.forEach(x=>x.addEventListener('input',refresh));refresh();
 document.getElementById('allocationForm').addEventListener('submit',e=>{let total=inputs.reduce((s,x)=>s+(parseFloat(x.value)||0),0);if(total>budget+0.005){e.preventDefault();alert('جمع تخصیص نمی‌تواند از بودجه بیشتر باشد.');}});
})();
</script>