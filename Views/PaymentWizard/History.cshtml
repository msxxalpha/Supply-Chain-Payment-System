@model List<Indamin.Payment.Data.PaymentRun>
@using Indamin.Payment.Data
@{ViewData["Title"]="سوابق تخصیص‌های ثبت‌شده";}
<div class="page-header"><div><div class="eyebrow">تاریخچه مالی</div><h2>سوابق تخصیص و دستورهای پرداخت</h2><p class="text-muted">محاسبات تاییدشده تا قبل از صدور دستور پرداخت قابل حذف منطقی هستند؛ پس از صدور دستور پرداخت، رکورد و مبلغ آن قفل می‌شود.</p></div><div class="export-group"><a class="btn btn-outline-secondary" href="/PaymentWizard/Deleted">محاسبات حذف‌شده</a><a class="btn btn-main" href="/PaymentWizard">محاسبه جدید</a></div></div>
<div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#runs" placeholder="جست‌وجوی عنوان، شماره یا وضعیت..."></div><div class="table-responsive"><table id="runs" class="table modern-table"><thead><tr><th>شماره</th><th>عنوان</th><th>تاریخ محاسبه</th><th>دوره رسید</th><th>بودجه</th><th>تخصیص</th><th>تعداد رسید</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>
@foreach(var r in Model){var ordered=r.Status==PaymentRunStatus.PaymentOrdered;<tr><td>#@r.Id</td><td class="fw-bold">@r.Title</td><td>@r.CalculationDateJalali</td><td>@r.PeriodFromJalali تا @r.PeriodToJalali</td><td>@r.TotalAllocationBudget.ToString("N0") @r.AmountUnit</td><td class="amount-emphasis">@r.Invoices.Sum(x=>x.AllocatedAmount).ToString("N0")</td><td>@r.Invoices.Count</td><td><span class="status-pill @(ordered?"status-ordered":"status-approved")">@(ordered?"دستور پرداخت شده":"تایید شده")</span></td><td class="text-nowrap">
<a class="btn btn-sm btn-outline-primary" href="/PaymentWizard/Details/@r.Id">جزئیات</a>
<a class="btn btn-sm btn-outline-secondary" href="/PaymentWizard/ExportRun/@r.Id">Excel</a>
<a class="btn btn-sm btn-outline-secondary" href="/PaymentWizard/ExportSummary/@r.Id">خلاصه</a>
@if(ordered){<a class="btn btn-sm btn-main" href="/PaymentWizard/DownloadPaymentOrder/@r.Id">دریافت دستور پرداخت PDF</a>}else{@if(User.HasClaim("Permission","Payment.OrderCreate")){<form method="post" action="/PaymentWizard/CreatePaymentOrder" class="d-inline" data-confirm="پس از ثبت دستور پرداخت، محاسبه دیگر قابل تغییر یا حذف نخواهد بود. ادامه می‌دهید؟">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id"><button class="btn btn-sm btn-main">ثبت دستور پرداخت</button></form>}@if(User.HasClaim("Permission","Payment.Delete")){<form method="post" action="/PaymentWizard/Delete" class="d-inline" data-confirm="محاسبه به‌صورت منطقی حذف شود؟ پس از حذف، تخصیص آن دیگر در مانده بدهی محاسبات بعدی لحاظ نخواهد شد."><input type="hidden" name="id" value="@r.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary">حذف محاسبه</button></form>}}</td></tr>}
</tbody></table></div></div>