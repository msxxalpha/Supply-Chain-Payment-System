@model List<Indamin.Payment.Data.PaymentRun>
@using Indamin.Payment.Data
@{ViewData["Title"]="سوابق تخصیص‌های ثبت‌شده";}
<div class="page-header"><div><div class="eyebrow">تاریخچه مالی</div><h2>دفعات تاییدشده تخصیص پرداخت</h2><p class="text-muted">هر ردیف یک نوبت محاسبه تاییدشده است؛ جزئیات رسیدها و خروجی Excel در دسترس است.</p></div><a class="btn btn-main" href="/PaymentWizard">محاسبه جدید</a></div>
<div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#runs" placeholder="جست‌وجوی عنوان، شماره یا وضعیت..."></div><div class="table-responsive"><table id="runs" class="table modern-table"><thead><tr><th>شماره</th><th>عنوان</th><th>تاریخ محاسبه</th><th>دوره رسید</th><th>بودجه</th><th>تخصیص</th><th>تعداد رسید</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>#@r.Id</td><td class="fw-bold">@r.Title</td><td>@r.CalculationDateJalali</td><td>@r.PeriodFromJalali تا @r.PeriodToJalali</td><td>@r.TotalAllocationBudget.ToString("N0") @r.AmountUnit</td><td class="amount-emphasis">@r.Invoices.Sum(x=>x.AllocatedAmount).ToString("N0")</td><td>@r.Invoices.Count</td><td>@r.Status</td><td><a class="btn btn-sm btn-outline-primary" href="/PaymentWizard/Details/@r.Id">جزئیات</a> <a class="btn btn-sm btn-outline-secondary" href="/PaymentWizard/ExportRun/@r.Id">Excel</a> <a class="btn btn-sm btn-outline-secondary" href="/PaymentWizard/ExportSummary/@r.Id">خلاصه تامین‌کنندگان</a></td></tr>}</tbody></table></div></div>