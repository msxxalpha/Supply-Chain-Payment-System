@model List<Indamin.Payment.Data.PaymentRun>
@using Indamin.Payment.Data
@{ViewData["Title"]="سوابق تخصیص‌های ثبت‌شده";}
<div class="page-header"><div><div class="eyebrow">تاریخچه مالی</div><h2>سوابق پرداخت‌های محاسباتی و غیرمحاسباتی</h2><p class="text-muted">محاسبات تا پیش از صدور دستور پرداخت قابل حذف منطقی هستند؛ پرداخت‌های غیرمحاسباتی هنگام ثبت نهایی مستقیماً با وضعیت دستور پرداخت ثبت می‌شوند.</p></div><div class="export-group"><a class="btn btn-outline-secondary" href="/PaymentWizard/Deleted">پرداخت‌های حذف‌شده</a><a class="btn btn-main" href="/PaymentWizard">پرداخت محاسباتی جدید</a><a class="btn btn-outline-primary" href="/NonCalculatedPayment">پرداخت غیرمحاسباتی جدید</a></div></div>
<div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#runs" placeholder="جست‌وجوی عنوان، شماره، نوع یا وضعیت..."></div><div class="table-responsive"><table id="runs" class="table modern-table"><thead><tr><th>شماره</th><th>نوع پرداخت</th><th>منبع رسید</th><th>روش مطالبات جاری</th><th>عنوان</th><th>تاریخ</th><th>مبلغ کل</th><th>تخصیص جاری</th><th>تخصیص استقراری</th><th>تعداد تامین‌کننده</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>
@foreach(var r in Model){var ordered=r.Status==PaymentRunStatus.PaymentOrdered;var initial=r.SupplierSummaries.Sum(x=>x.InitialClaimAllocatedAmount);var current=r.SupplierSummaries.Sum(x=>x.CurrentClaimAllocatedAmount);var total=r.SupplierSummaries.Sum(x=>x.AllocatedAmount);<tr>
<td>#@r.Id</td><td><span class="status-pill @(r.RunType==PaymentRunType.NonCalculated?"status-ordered":"status-approved")">@(r.RunType==PaymentRunType.NonCalculated?"غیرمحاسباتی":"محاسباتی")</span></td><td>@(r.RunType==PaymentRunType.NonCalculated?"—":r.ReceiptSource==PaymentReceiptSource.WarehouseSubsystem?"زیرسیستم انبار":"Excel")</td><td>@if(r.RunType==PaymentRunType.NonCalculated){<span>—</span>}else{<span>@(r.SystemParameterSnapshots.FirstOrDefault(x=>x.Code=="CURRENT_CLAIM_CALC_METHOD")?.Value==2?"تعدادی بر اساس فهرست بها":"دریافت اطلاعات ریالی")</span>}</td><td class="fw-bold">@r.Title</td><td>@r.CalculationDateJalali</td><td class="amount-emphasis">@total.ToString("N0") ریال</td><td>@current.ToString("N0")</td><td>@initial.ToString("N0")</td><td>@r.SupplierSummaries.Count</td><td><span class="status-pill @(ordered?"status-ordered":"status-approved")">@(ordered?"دستور پرداخت شده":"تایید شده")</span></td>
<td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="/PaymentWizard/Details/@r.Id">جزئیات</a><a class="btn btn-sm btn-outline-secondary" href="/PaymentWizard/ExportRun/@r.Id">Excel</a><a class="btn btn-sm btn-outline-secondary" href="/PaymentWizard/ExportSummary/@r.Id">خلاصه</a>
@if(ordered){@if(User.HasClaim("Permission","Payment.OrderDownload")){<a class="btn btn-sm btn-main" href="/PaymentWizard/DownloadPaymentOrder/@r.Id">دستور پرداخت PDF</a>}@if(User.HasClaim("IsAdmin","1")&&User.HasClaim("Permission","Payment.Delete")){<form method="post" action="/PaymentWizard/Delete" class="d-inline" data-confirm="دستور پرداخت به‌صورت منطقی حذف شود؟ سابقه حفظ و آثار مالی آن از محاسبات بعدی خارج می‌شود. ادامه می‌دهید؟">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id"><button class="btn btn-sm btn-outline-danger">حذف منطقی</button></form>}}else{@if(r.RunType==PaymentRunType.Calculated && User.HasClaim("Permission","Payment.OrderCreate")){<form method="post" action="/PaymentWizard/CreatePaymentOrder" class="d-inline" data-confirm="پس از ثبت دستور پرداخت، این پرداخت دیگر قابل تغییر یا حذف نخواهد بود. ادامه می‌دهید؟">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id"><button class="btn btn-sm btn-main">ثبت دستور پرداخت</button></form>}@if(User.HasClaim("Permission","Payment.Delete")){<form method="post" action="/PaymentWizard/Delete" class="d-inline" data-confirm="پرداخت به صورت منطقی حذف شود؟">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id"><button class="btn btn-sm btn-outline-secondary">حذف</button></form>}}</td></tr>}
</tbody></table></div></div>