@model Indamin.Payment.Controllers.SetupController.PartsVm
@{ViewData["Title"]="کالاهای زنجیره تامین";}
<div class="page-header"><div><div class="eyebrow">اطلاعات پایه</div><h2>کالاهای زنجیره تامین</h2><p class="text-muted">ورود مستقیم یا Excel و مدیریت وضعیت قطعات.</p></div><div class="export-group"><a class="btn btn-outline-primary" href="/Setup/ExportParts">خروجی Excel</a></div></div>
<div class="excel-column-guide mb-3"><h5>راهنمای ترتیب ستون‌های فایل Excel کالاها</h5><div class="guide-columns"><div class="guide-col"><b><span class="num">۱</span>کد قطعه</b><small>الزامی و یکتا؛ نمونه: P-001</small></div><div class="guide-col"><b><span class="num">۲</span>عنوان قطعه</b><small>عنوان کامل کالا</small></div><div class="guide-col"><b><span class="num">۳</span>نوع قطعه</b><small>یکی از انواع فعال تعریف‌شده در اطلاعات پایه</small></div><div class="guide-col"><b><span class="num">۴</span>فعال یا غیرفعال بودن</b><small>مقدار مجاز: فعال / غیرفعال یا ۱ / ۰</small></div></div><div class="form-hint mt-2">ترتیب ستون‌های فایل باید دقیقاً مطابق موارد بالا باشد. ردیف اول فایل عنوان ستون‌ها باشد.</div></div><div class="row g-3 mb-3"><div class="col-lg-7"><div class="form-panel h-100"><h4>تعریف قطعه</h4><form method="post" action="/Setup/AddPart" class="row g-2 mt-1">@Html.AntiForgeryToken()<div class="col-md-4"><label class="form-label">کد قطعه</label><input class="form-control" name="code" required></div><div class="col-md-4"><label class="form-label">عنوان قطعه</label><input class="form-control" name="title" required></div><div class="col-md-4"><label class="form-label">نوع قطعه</label><select class="form-select" name="typeId">@foreach(var t in Model.Types){<option value="@t.Id">@t.Title</option>}</select></div><div class="col-12"><button class="btn btn-main">ثبت قطعه</button></div></form></div></div><div class="col-lg-5"><div class="form-panel h-100"><h4>ورود از Excel</h4><p class="subtle">ستون‌ها: کد قطعه، عنوان قطعه، نوع قطعه، فعال یا غیرفعال بودن.</p><form method="post" action="/Setup/ImportParts" enctype="multipart/form-data" class="mt-3">@Html.AntiForgeryToken()<input class="form-control mb-2" type="file" name="file" accept=".xlsx,.xls"><button class="btn btn-outline-primary">ورود/به‌روزرسانی</button></form></div></div></div>
<div class="table-panel"><form class="toolbar" method="get" action="/Setup/Parts"><input class="form-control" name="q" value="@Model.Search" placeholder="جست‌وجوی کد، عنوان یا نوع..."><select class="form-select page-size-select" name="pageSize" onchange="this.form.submit()"><option value="25" selected="@(Model.PageSize==25)">25 ردیف</option><option value="50" selected="@(Model.PageSize==50)">50 ردیف</option><option value="75" selected="@(Model.PageSize==75)">75 ردیف</option><option value="100" selected="@(Model.PageSize==100)">100 ردیف</option></select><button class="btn btn-outline-primary">جست‌وجو</button></form><div class="table-responsive"><table id="parts" class="table modern-table"><thead><tr><th>کد</th><th>عنوان</th><th>نوع</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>@foreach(var p in Model.Rows){<tr><td>@p.Code</td><td class="fw-bold">@p.Title</td><td>@p.Type?.Title</td><td>@(p.IsActive?"فعال":"غیرفعال")</td><td><button class="btn btn-sm btn-outline-secondary" type="button" data-edit-toggle="part-@p.Id">ویرایش</button>@if(Model.LockedIds.Contains(p.Id)){<span class="badge text-bg-light">استفاده‌شده در محاسبه تاییدشده؛ فقط غیرفعال</span>}else{<form method="post" action="/Setup/DeletePart" class="d-inline" data-confirm="حذف قطعه انجام شود؟">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"><button class="btn btn-sm btn-outline-secondary">حذف</button></form>}</td></tr><tr class="edit-row" id="part-@p.Id"><td colspan="5"><form method="post" action="/Setup/EditPart" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"><div class="col-md-3"><input class="form-control" name="code" value="@p.Code"></div><div class="col-md-4"><input class="form-control" name="title" value="@p.Title"></div><div class="col-md-3"><select class="form-select" name="typeId">@foreach(var t in Model.Types){<option value="@t.Id" selected="@(t.Id==p.TypeId)">@t.Title</option>}</select></div><div class="col-md-2"><label class="form-check"><input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@p.IsActive"> فعال</label><button class="btn btn-main btn-sm">ذخیره</button></div></form></td></tr>}</tbody></table></div></div>
@{var totalPages=Math.Max(1,(int)Math.Ceiling(Model.TotalCount/(double)Model.PageSize));}<div class="pagination-bar"><span>نمایش @Model.Rows.Count از @Model.TotalCount ردیف</span><div class="pagination-links">@for(var i=1;i<=totalPages;i++){if(i==Model.Page){<span class="page-link active">@i</span>}else{<a class="page-link" href="/Setup/Parts?page=@i&pageSize=@Model.PageSize&q=@Uri.EscapeDataString(Model.Search??"")">@i</a>}}</div></div>