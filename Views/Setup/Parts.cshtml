@model Indamin.Payment.Controllers.SetupController.PartsVm
@{ViewData["Title"]="کالاهای زنجیره تامین";}
<div class="page-header"><div><div class="eyebrow">اطلاعات پایه</div><h2>کالاهای زنجیره تامین</h2><p class="text-muted">ورود مستقیم یا Excel و مدیریت وضعیت قطعات.</p></div><div class="export-group"><a class="btn btn-outline-primary" href="/Setup/ExportParts">خروجی Excel</a></div></div>
<div class="row g-3 mb-3"><div class="col-lg-7"><div class="form-panel h-100"><h4>تعریف قطعه</h4><form method="post" action="/Setup/AddPart" class="row g-2 mt-1">@Html.AntiForgeryToken()<div class="col-md-4"><label class="form-label">کد قطعه</label><input class="form-control" name="code" required></div><div class="col-md-4"><label class="form-label">عنوان قطعه</label><input class="form-control" name="title" required></div><div class="col-md-4"><label class="form-label">نوع قطعه</label><select class="form-select" name="typeId">@foreach(var t in Model.Types){<option value="@t.Id">@t.Title</option>}</select></div><div class="col-12"><button class="btn btn-main">ثبت قطعه</button></div></form></div></div><div class="col-lg-5"><div class="form-panel h-100"><h4>ورود از Excel</h4><p class="subtle">ستون‌ها: کد قطعه، عنوان قطعه، نوع قطعه، فعال یا غیرفعال بودن.</p><form method="post" action="/Setup/ImportParts" enctype="multipart/form-data" class="mt-3">@Html.AntiForgeryToken()<input class="form-control mb-2" type="file" name="file" accept=".xlsx,.xls"><button class="btn btn-outline-primary">ورود/به‌روزرسانی</button></form></div></div></div>
<div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#parts" placeholder="جست‌وجوی کد، عنوان یا نوع..."></div><div class="table-responsive"><table id="parts" class="table modern-table"><thead><tr><th>کد</th><th>عنوان</th><th>نوع</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>@foreach(var p in Model.Rows){<tr><td>@p.Code</td><td class="fw-bold">@p.Title</td><td>@p.Type?.Title</td><td>@(p.IsActive?"فعال":"غیرفعال")</td><td><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#part-@p.Id">ویرایش</button><form method="post" action="/Setup/DeletePart" class="d-inline" data-confirm="حذف قطعه انجام شود؟">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"><button class="btn btn-sm btn-outline-secondary">حذف</button></form></td></tr><tr class="collapse" id="part-@p.Id"><td colspan="5"><form method="post" action="/Setup/EditPart" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"><div class="col-md-3"><input class="form-control" name="code" value="@p.Code"></div><div class="col-md-4"><input class="form-control" name="title" value="@p.Title"></div><div class="col-md-3"><select class="form-select" name="typeId">@foreach(var t in Model.Types){<option value="@t.Id" selected="@(t.Id==p.TypeId)">@t.Title</option>}</select></div><div class="col-md-2"><label class="form-check"><input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@p.IsActive"> فعال</label><button class="btn btn-main btn-sm">ذخیره</button></div></form></td></tr>}</tbody></table></div></div>