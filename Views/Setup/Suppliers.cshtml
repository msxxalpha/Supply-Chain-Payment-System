@model Indamin.Payment.Controllers.SetupController.SuppliersVm
@{ViewData["Title"]="تامین‌کنندگان";}
<div class="page-header"><div><div class="eyebrow">اطلاعات پایه</div><h2>تامین‌کنندگان زنجیره تامین</h2><p class="text-muted">حوزه فعالیت چندانتخابی است و واردسازی Excel نیز پشتیبانی می‌شود.</p></div><a class="btn btn-outline-primary" href="/Setup/ExportSuppliers">خروجی Excel</a></div>
<div class="excel-column-guide mb-3"><h5>راهنمای ترتیب ستون‌های فایل Excel تامین‌کنندگان</h5><div class="guide-columns"><div class="guide-col"><b><span class="num">۱</span>کد تامین کننده</b><small>الزامی و یکتا؛ نمونه: SUP-001</small></div><div class="guide-col"><b><span class="num">۲</span>عنوان تامین کننده</b><small>نام کامل تامین‌کننده؛ نمونه: شرکت نمونه</small></div><div class="guide-col"><b><span class="num">۳</span>مبلغ مطالبات استقراری</b><small>مبلغ اولیه مطالبات انتقال‌یافته از قبل؛ پیش‌فرض صفر.</small></div><div class="guide-col"><b><span class="num">۴</span>حوزه فعالیت</b><small>چند انتخابی؛ موارد را با «؛» جدا کنید و هر مورد باید در اطلاعات پایه تعریف شده باشد.</small></div><div class="guide-col"><b><span class="num">۵</span>فعال یا غیرفعال بودن</b><small>مقدار مجاز: فعال / غیرفعال یا ۱ / ۰</small></div></div><div class="form-hint mt-2">ترتیب ستون‌های فایل باید دقیقاً مطابق موارد بالا باشد. ردیف اول فایل عنوان ستون‌ها باشد.</div></div><div class="row g-3 mb-3"><div class="col-lg-7"><div class="form-panel"><h4>تعریف تامین‌کننده</h4><form method="post" action="/Setup/AddSupplier" class="row g-2">@Html.AntiForgeryToken()<div class="col-md-4"><label class="form-label">کد</label><input class="form-control" name="code" required></div><div class="col-md-8"><label class="form-label">عنوان</label><input class="form-control" name="title" required></div><div class="col-md-4"><label class="form-label">مطالبات استقراری</label><input class="form-control" name="initialClaimAmount" type="number" min="0" step="0.01" value="0"></div><div class="col-12"><label class="form-label">حوزه‌های فعالیت</label><select class="form-select" name="activityIds" multiple size="4">@foreach(var a in Model.Activities){<option value="@a.Id">@a.Title</option>}</select></div><div class="col-12"><button class="btn btn-main">ثبت تامین‌کننده</button></div></form></div></div><div class="col-lg-5"><div class="form-panel"><h4>ورود از Excel</h4><p class="subtle">حوزه‌های فعالیت چندانتخابی را با «؛» از یکدیگر جدا کنید. ستون‌ها را مطابق راهنمای بالای صفحه قرار دهید.</p><form method="post" action="/Setup/ImportSuppliers" enctype="multipart/form-data" class="mt-3">@Html.AntiForgeryToken()<input class="form-control mb-2" type="file" name="file" accept=".xlsx,.xls"><button class="btn btn-outline-primary">ورود/به‌روزرسانی</button></form></div></div></div>
<div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#suppliers" placeholder="جست‌وجوی کد، نام یا حوزه..."></div><div class="table-responsive"><table id="suppliers" class="table modern-table"><thead><tr><th>کد</th><th>تامین‌کننده</th><th>مطالبات استقراری</th><th>حوزه فعالیت</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>@foreach(var s in Model.Rows){<tr><td>@s.Code</td><td class="fw-bold">@s.Title</td><td>@s.InitialClaimAmount.ToString("N0")</td><td>@string.Join("، ",s.Activities.Where(a=>a.Activity!=null).Select(a=>a.Activity!.Title))</td><td>@(s.IsActive?"فعال":"غیرفعال")</td><td><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#supplier-@s.Id">ویرایش</button><form method="post" action="/Setup/DeleteSupplier" class="d-inline" data-confirm="حذف تامین‌کننده انجام شود؟">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@s.Id"><button class="btn btn-sm btn-outline-secondary">حذف</button></form></td></tr><tr class="collapse" id="supplier-@s.Id"><td colspan="6"><form method="post" action="/Setup/EditSupplier" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@s.Id"><div class="col-md-3"><input class="form-control" name="code" value="@s.Code"></div><div class="col-md-3"><input class="form-control" name="title" value="@s.Title"></div><div class="col-md-3"><input class="form-control" name="initialClaimAmount" type="number" min="0" step="0.01" value="@s.InitialClaimAmount"></div><div class="col-md-3"><select class="form-select" name="activityIds" multiple>@foreach(var a in Model.Activities){<option value="@a.Id" selected="@(s.Activities.Any(z=>z.ActivityId==a.Id))">@a.Title</option>}</select></div><div class="col-md-2 d-flex align-items-center"><label class="form-check"><input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@s.IsActive"> فعال</label><button class="btn btn-main btn-sm ms-2">ذخیره</button></div></form></td></tr>}</tbody></table></div></div>