@model Indamin.Payment.Controllers.SetupController.LookupVm
@{ViewData["Title"]="سایر اطلاعات پایه";}
<div class="page-header"><div><div class="eyebrow">اطلاعات پایه</div><h2>مدیریت مقادیر انتخابی</h2><p class="text-muted">گروه‌های نوع قطعه و حوزه فعالیت تامین‌کنندگان از این بخش قابل توسعه هستند.</p></div><form method="get"><select class="form-select" name="group" onchange="this.form.submit()">@foreach(var g in Model.Groups){<option value="@g" selected="@(g==Model.Group)">@g</option>}</select></form></div>
<div class="form-panel mb-3"><form method="post" action="/Setup/AddLookup" class="row g-2">@Html.AntiForgeryToken()<div class="col-lg-3"><label class="form-label">گروه</label><input class="form-control" name="groupCode" value="@Model.Group" required></div><div class="col-lg-3"><label class="form-label">کد</label><input class="form-control" name="code" required></div><div class="col-lg-4"><label class="form-label">عنوان</label><input class="form-control" name="title" required></div><div class="col-lg-1"><label class="form-label">ترتیب</label><input class="form-control" type="number" name="sortOrder" value="1"></div><div class="col-lg-1 d-flex align-items-end"><button class="btn btn-main w-100">افزودن</button></div></form></div>
<div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#lookups" placeholder="جست‌وجو..."></div><div class="table-responsive"><table id="lookups" class="table modern-table"><thead><tr><th>کد</th><th>عنوان</th><th>ترتیب</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>@foreach(var x in Model.Rows){<tr><td>@x.Code</td><td class="fw-bold">@x.Title</td><td>@x.SortOrder</td><td>@(x.IsActive?"فعال":"غیرفعال")</td><td><form method="post" action="/Setup/EditLookup" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><input type="hidden" name="code" value="@x.Code"><input type="hidden" name="title" value="@x.Title"><input type="hidden" name="sortOrder" value="@x.SortOrder"><input type="hidden" name="group" value="@Model.Group"><input type="hidden" name="isActive" value="@(!x.IsActive)"><button class="btn btn-sm btn-outline-secondary">تغییر وضعیت</button></form></td></tr>}</tbody></table></div></div>