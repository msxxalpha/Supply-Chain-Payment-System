@model Indamin.Payment.Controllers.SetupController.MappingsVm
@{ViewData["Title"]="ارتباط کالا و تامین‌کننده";}

<div class="page-header">
  <div><div class="eyebrow">اطلاعات پایه</div><h2>ارتباط بین کالا و تامین‌کننده</h2><p class="text-muted">ظرفیت تامین و مهلت تسویه قراردادی برای هر ارتباط در محاسبه پرداخت استفاده می‌شود.</p></div>
  <div class="export-group"><a class="btn btn-outline-primary" href="/Setup/ExportMappings">خروجی Excel</a></div>
</div>

<div class="excel-column-guide mapping-excel-guide mb-3">
  <h5>راهنمای ترتیب ستون‌های فایل Excel ارتباط کالا و تامین‌کننده</h5>
  <div class="guide-columns">
    <div class="guide-col"><b><span class="num">۱</span>کد تامین کننده</b><small>الزامی؛ باید در اطلاعات پایه تامین‌کنندگان وجود داشته باشد. نمونه: SUP-001</small></div>
    <div class="guide-col"><b><span class="num">۲</span>کد قطعه</b><small>الزامی؛ باید در اطلاعات پایه کالاها وجود داشته باشد. نمونه: P-001</small></div>
    <div class="guide-col"><b><span class="num">۳</span>ظرفیت تامین</b><small>عدد صفر یا بزرگ‌تر، با امکان اعشار</small></div>
    <div class="guide-col"><b><span class="num">۴</span>مهلت تسویه (روز)</b><small>عدد صحیح بزرگ‌تر از صفر؛ نمونه: ۳۰</small></div>
    <div class="guide-col"><b><span class="num">۵</span>فعال یا غیرفعال بودن</b><small>مقدار مجاز: فعال / غیرفعال یا ۱ / ۰</small></div>
  </div>
  <div class="form-hint mt-2">ردیف اول فایل عنوان ستون‌ها باشد. در صورت وجود ارتباط قبلی، اطلاعات آن به‌روزرسانی می‌شود.</div>
</div>

<div class="row g-3 mb-3">
  <div class="col-xl-8">
    <div class="form-panel h-100">
      <h4>تعریف ارتباط جدید</h4>
      <div class="form-hint mb-2">برای پیدا کردن سریع آیتم، در کادر جست‌وجوی هر کمبو بخشی از کد یا نام را تایپ کنید.</div>
      <form method="post" action="/Setup/SaveMapping" class="row g-2 mt-1">@Html.AntiForgeryToken()
        <div class="col-md-6">
          <label class="form-label">تامین‌کننده</label>
          <div class="searchable-select" data-filter-select>
            <input class="form-control searchable-select-filter" type="text" placeholder="فیلتر تامین‌کننده..." autocomplete="off" data-select-filter-input>
            <select class="form-select" name="supplierId" data-select-filter-target required>
              @foreach(var x in Model.Suppliers){<option value="@x.Id">@x.Code - @x.Title</option>}
            </select>
          </div>
        </div>
        <div class="col-md-6">
          <label class="form-label">کالا</label>
          <div class="searchable-select" data-filter-select>
            <input class="form-control searchable-select-filter" type="text" placeholder="فیلتر کالا..." autocomplete="off" data-select-filter-input>
            <select class="form-select" name="partId" data-select-filter-target required>
              @foreach(var x in Model.Parts){<option value="@x.Id">@x.Code - @x.Title</option>}
            </select>
          </div>
        </div>
        <div class="col-md-4"><label class="form-label">ظرفیت تامین</label><input class="form-control" type="number" step="0.01" min="0" name="supplyCapacity" value="0" required></div>
        <div class="col-md-4"><label class="form-label">مهلت تسویه (روز)</label><input class="form-control" type="number" min="1" name="contractSettlementDays" value="30" required></div>
        <div class="col-md-4 d-flex align-items-end"><button class="btn btn-main w-100">ثبت ارتباط</button></div>
      </form>
    </div>
  </div>
  <div class="col-xl-4">
    <div class="form-panel h-100">
      <h4>ورود ارتباط‌ها از Excel</h4>
      <p class="subtle">فایل می‌تواند چندین ارتباط را همزمان ایجاد یا به‌روزرسانی کند. کد تامین‌کننده و کد کالا مبنای تطبیق هستند.</p>
      <form method="post" action="/Setup/ImportMappings" enctype="multipart/form-data" class="mt-3">@Html.AntiForgeryToken()
        <input class="form-control mb-2" type="file" name="file" accept=".xlsx,.xls" required>
        <button class="btn btn-outline-primary w-100">ورود / به‌روزرسانی ارتباط‌ها</button>
      </form>
    </div>
  </div>
</div>

<div class="table-panel">
  <div class="toolbar"><input class="form-control" data-table-filter="#maps" placeholder="جست‌وجوی تامین‌کننده، کالا یا کد..."></div>
  <div class="table-responsive"><table id="maps" class="table modern-table">
    <thead><tr><th>تامین‌کننده</th><th>کالا</th><th>ظرفیت</th><th>مهلت تسویه</th><th>وضعیت</th><th>عملیات</th></tr></thead>
    <tbody>
    @foreach(var m in Model.Rows){
      <tr>
        <td class="fw-bold">@m.Supplier?.Code - @m.Supplier?.Title</td><td>@m.Part?.Code - @m.Part?.Title</td><td>@m.SupplyCapacity</td><td>@m.ContractSettlementDays روز</td><td>@(m.IsActive?"فعال":"غیرفعال")</td>
        <td><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#map-@m.Id">ویرایش</button>
          @if(Model.LockedIds.Contains(m.Id)){<span class="badge text-bg-light">استفاده‌شده در محاسبه تاییدشده؛ فقط غیرفعال</span>}else{<form method="post" action="/Setup/DeleteMapping" class="d-inline" data-confirm="این ارتباط حذف شود؟">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@m.Id"><button class="btn btn-sm btn-outline-secondary">حذف</button></form>}
        </td>
      </tr>
      <tr class="collapse" id="map-@m.Id"><td colspan="6">
        <form method="post" action="/Setup/SaveMapping" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@m.Id">
          <div class="col-md-3"><label class="form-label">تامین‌کننده</label><div class="searchable-select" data-filter-select><input class="form-control searchable-select-filter" type="text" placeholder="فیلتر..." autocomplete="off" data-select-filter-input><select class="form-select" name="supplierId" data-select-filter-target required>@foreach(var x in Model.Suppliers){<option value="@x.Id" selected="@(x.Id==m.SupplierId)">@x.Code - @x.Title</option>}</select></div></div>
          <div class="col-md-3"><label class="form-label">کالا</label><div class="searchable-select" data-filter-select><input class="form-control searchable-select-filter" type="text" placeholder="فیلتر..." autocomplete="off" data-select-filter-input><select class="form-select" name="partId" data-select-filter-target required>@foreach(var x in Model.Parts){<option value="@x.Id" selected="@(x.Id==m.PartId)">@x.Code - @x.Title</option>}</select></div></div>
          <div class="col-md-2"><label class="form-label">ظرفیت تامین</label><input class="form-control" type="number" step="0.01" min="0" name="supplyCapacity" value="@m.SupplyCapacity" required></div>
          <div class="col-md-2"><label class="form-label">مهلت تسویه</label><input class="form-control" type="number" min="1" name="contractSettlementDays" value="@m.ContractSettlementDays" required></div>
          <div class="col-md-2 d-flex align-items-end gap-2"><label class="form-check mb-0"><input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@m.IsActive"> فعال</label><button class="btn btn-main btn-sm">ذخیره</button></div>
        </form>
      </td></tr>
    }
    </tbody>
  </table></div>
</div>