@model Indamin.Payment.Controllers.SetupController.MappingsVm
@{ViewData["Title"]="ارتباط قطعه–تامین‌کننده";}
<div class="page-header"><div><div class="eyebrow">اطلاعات پایه</div><h2>ارتباط بین قطعه و تامین‌کننده</h2><p class="text-muted">ظرفیت تامین و مهلت تسویه قراردادی برای هر ارتباط در محاسبه پرداخت استفاده می‌شود.</p></div></div>
<div class="form-panel mb-3"><h4>تعریف ارتباط جدید</h4><form method="post" action="/Setup/SaveMapping" class="row g-2 mt-1">@Html.AntiForgeryToken()<div class="col-lg-3"><label class="form-label">تامین‌کننده</label><select class="form-select" name="supplierId">@foreach(var x in Model.Suppliers){<option value="@x.Id">@x.Code - @x.Title</option>}</select></div><div class="col-lg-3"><label class="form-label">قطعه</label><select class="form-select" name="partId">@foreach(var x in Model.Parts){<option value="@x.Id">@x.Code - @x.Title</option>}</select></div><div class="col-lg-2"><label class="form-label">ظرفیت تامین</label><input class="form-control" type="number" step="0.01" min="0" name="supplyCapacity" value="0"></div><div class="col-lg-2"><label class="form-label">مهلت تسویه (روز)</label><input class="form-control" type="number" min="1" name="contractSettlementDays" value="30"></div><div class="col-lg-2 d-flex align-items-end"><button class="btn btn-main w-100">ثبت ارتباط</button></div></form></div>
<div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#maps" placeholder="جست‌وجوی تامین‌کننده یا قطعه..."></div><div class="table-responsive"><table id="maps" class="table modern-table"><thead><tr><th>تامین‌کننده</th><th>قطعه</th><th>ظرفیت</th><th>مهلت تسویه</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>@foreach(var m in Model.Rows){<tr><td class="fw-bold">@m.Supplier?.Title</td><td>@m.Part?.Code - @m.Part?.Title</td><td>@m.SupplyCapacity</td><td>@m.ContractSettlementDays روز</td><td>@(m.IsActive?"فعال":"غیرفعال")</td><td><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#map-@m.Id">ویرایش</button><form method="post" action="/Setup/DeleteMapping" class="d-inline" data-confirm="این ارتباط حذف شود؟">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@m.Id"><button class="btn btn-sm btn-outline-secondary">حذف</button></form></td></tr><tr class="collapse" id="map-@m.Id"><td colspan="6"><form method="post" action="/Setup/SaveMapping" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@m.Id"><div class="col-md-3"><select class="form-select" name="supplierId">@foreach(var x in Model.Suppliers){<option value="@x.Id" selected="@(x.Id==m.SupplierId)">@x.Title</option>}</select></div><div class="col-md-3"><select class="form-select" name="partId">@foreach(var x in Model.Parts){<option value="@x.Id" selected="@(x.Id==m.PartId)">@x.Code - @x.Title</option>}</select></div><div class="col-md-2"><input class="form-control" type="number" step="0.01" name="supplyCapacity" value="@m.SupplyCapacity"></div><div class="col-md-2"><input class="form-control" type="number" min="1" name="contractSettlementDays" value="@m.ContractSettlementDays"></div><div class="col-md-2 d-flex align-items-center"><label class="form-check"><input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@m.IsActive"> فعال</label><button class="btn btn-main btn-sm">ذخیره</button></div></form></td></tr>}</tbody></table></div></div>