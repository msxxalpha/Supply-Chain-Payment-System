@model Indamin.Payment.Controllers.SetupController.ParametersVm
@using Indamin.Payment.Data
@{ViewData["Title"]="پارامترهای پرداخت";var total=Model.Rows.Where(x=>x.IsActive).Sum(x=>x.Weight);}
<div class="page-header"><div><div class="eyebrow">اطلاعات پایه</div><h2>پارامترهای موثر بر مبلغ قابل تخصیص</h2><p class="text-muted">هر پارامتر با سقف امتیاز ۵ تعریف می‌شود. اجرای ویزارد فقط در صورت برابر بودن مجموع اوزان فعال با ۱۰۰٪ مجاز است.</p></div><div class="toolbar-actions"><span class="validation-chip @(Math.Abs(total-100m)<.0001m?"validation-ok":"validation-bad")">جمع وزن فعال: @total.ToString("0.####")٪</span></div></div>
<div class="form-panel mb-3"><div class="panel-title"><div><h4>تعریف پارامتر جدید</h4><span>برای پارامترهای خودکار، روش محاسبه را انتخاب کنید.</span></div></div><form method="post" action="/Setup/AddParameter" class="row g-2">@Html.AntiForgeryToken()<div class="col-lg-2"><label class="form-label">کد</label><input class="form-control" name="code" required></div><div class="col-lg-3"><label class="form-label">عنوان</label><input class="form-control" name="title" required></div><div class="col-lg-2"><label class="form-label">نوع</label><select class="form-select" name="type"><option value="Financial">مالی</option><option value="Time">زمان</option><option value="Part">قطعه</option><option value="Supplier">تامین‌کننده</option></select></div><div class="col-lg-1"><label class="form-label">وزن٪</label><input class="form-control" type="number" step="0.01" min="0" max="100" name="weight" value="0" required></div><div class="col-lg-2"><label class="form-label">روش امتیازدهی</label><select class="form-select" name="method"><option value="Manual">دستی</option><option value="DebtAgeEffective">سن بدهی موثر</option><option value="DebtAmount">مبلغ بدهی</option></select></div><div class="col-lg-2"><label class="form-label">ترتیب</label><input class="form-control" type="number" name="sortOrder" value="1"></div><div class="col-12"><label class="form-label">راهنمای امتیازدهی</label><textarea class="form-control" name="scoringGuide" rows="2" required></textarea></div><div class="col-12"><button class="btn btn-main">افزودن پارامتر</button></div></form></div>
<div class="table-panel"><div class="panel-title"><div><h4>مدیریت پارامترها</h4><span>ویرایش مستقیم، فعال/غیرفعال‌سازی و کنترل وزن‌ها</span></div></div><div class="toolbar"><input class="form-control" data-table-filter="#pars" placeholder="جست‌وجوی کد، عنوان یا نوع..."></div><div class="table-responsive"><table id="pars" class="table modern-table"><thead><tr><th>کد</th><th>عنوان</th><th>نوع</th><th>وزن٪</th><th>روش</th><th>راهنمای امتیازدهی</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>@foreach(var p in Model.Rows){<tr><td>@p.Code</td><td class="fw-bold">@p.Title</td><td>@p.Type</td><td>@p.Weight</td><td>@p.ScoringMethod</td><td class="subtle">@p.ScoringGuide</td><td>@(p.IsActive?"فعال":"غیرفعال")</td><td><form method="post" action="/Setup/EditParameter" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"><input type="hidden" name="code" value="@p.Code"><input type="hidden" name="title" value="@p.Title"><input type="hidden" name="type" value="@p.Type"><input type="hidden" name="weight" value="@p.Weight"><input type="hidden" name="scoringGuide" value="@p.ScoringGuide"><input type="hidden" name="method" value="@p.ScoringMethod"><input type="hidden" name="sortOrder" value="@p.SortOrder"><input type="hidden" name="isActive" value="@(!p.IsActive)"><button class="btn btn-sm btn-outline-secondary">فعال/غیرفعال</button></form></td></tr>}</tbody></table></div></div>