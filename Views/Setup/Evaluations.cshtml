@model Indamin.Payment.Controllers.SetupController.EvaluationsVm
@using Indamin.Payment.Data
@{ViewData["Title"]="ارزیابی قطعه–تامین‌کننده";}
<div class="page-header">
  <div><div class="eyebrow">اطلاعات پایه</div><h2>ارزیابی پارامترهای قطعه–تامین‌کننده</h2><p class="text-muted">با تعریف هر ارتباط قطعه–تامین‌کننده، پارامترهای دستی فعال به‌صورت خودکار با امتیاز پیش‌فرض ۱ ایجاد می‌شوند.</p></div>
  <div class="export-group"><a class="btn btn-outline-primary" href="/Setup/ExportEvaluations">خروجی Excel</a></div>
</div>
<div class="info-box mb-3">پارامترهای «سن بدهی موثر» و «مبلغ بدهی» خودکار هستند و در این صفحه قابل ورود دستی نیستند. برای هر ارتباط فقط یک دکمه در انتهای ردیف برای ثبت همه امتیازهای پارامترها وجود دارد.</div>
<div class="table-panel">
  <form class="toolbar" method="get" action="/Setup/Evaluations"><input class="form-control" name="q" value="@Model.Search" placeholder="جست‌وجوی تامین‌کننده، کد قطعه یا عنوان قطعه..."><select class="form-select page-size-select" name="pageSize" onchange="this.form.submit()"><option value="25" selected="@(Model.PageSize==25)">25 ردیف</option><option value="50" selected="@(Model.PageSize==50)">50 ردیف</option><option value="75" selected="@(Model.PageSize==75)">75 ردیف</option><option value="100" selected="@(Model.PageSize==100)">100 ردیف</option></select><button class="btn btn-outline-primary">جست‌وجو</button></form>
  @{var totalPages=Math.Max(1,(int)Math.Ceiling(Model.TotalCount/(double)Model.PageSize));}
  @await Html.PartialAsync("_TablePagination", (Model.Page, totalPages, Model.PageSize, Model.Search ?? "", "/Setup/Evaluations"))
  <div class="table-responsive"><table id="evals" class="table modern-table">
    <thead><tr><th>تامین‌کننده</th><th>قطعه</th>@foreach(var p in Model.Parameters){<th class="text-center">@p.Title<br><span class="subtle">وزن @p.Weight٪</span></th>}<th>عملیات</th></tr></thead>
    <tbody>
    @foreach(var m in Model.Mappings){
      <tr>
        <td class="fw-bold"><form id="eval-form-@m.Id" method="post" action="/Setup/SaveEvaluations">@Html.AntiForgeryToken()<input type="hidden" name="supplierPartId" value="@m.Id"></form>@m.Supplier?.Title</td><td>@m.Part?.Code - @m.Part?.Title</td>
        @foreach(var p in Model.Parameters){var sc=Model.Scores.FirstOrDefault(x=>x.SupplierPartId==m.Id&&x.PaymentParameterId==p.Id);var idx=Model.Parameters.IndexOf(p);<td class="score-cell"><input form="eval-form-@m.Id" class="form-control score-select" type="number" min="1" max="@p.MaxScore" step="0.1" name="items[@idx].Score" value="@(sc?.Score.ToString("0.##")??"1")" required><input form="eval-form-@m.Id" type="hidden" name="items[@idx].ParameterId" value="@p.Id"></td>}
        <td class="text-nowrap"><button form="eval-form-@m.Id" class="btn btn-sm btn-main">ثبت همه امتیازها</button>
          <form method="post" action="/Setup/ToggleEvaluationSet" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="supplierPartId" value="@m.Id"><button class="btn btn-sm btn-outline-secondary">@(Model.Scores.Where(x=>x.SupplierPartId==m.Id).Any(x=>x.IsActive)?"غیرفعال‌سازی":"فعال‌سازی")</button></form>
        </td>
      </tr>
    }
    </tbody>
  </table></div>
  @await Html.PartialAsync("_TablePagination", (Model.Page, totalPages, Model.PageSize, Model.Search ?? "", "/Setup/Evaluations"))
</div>
