@model Indamin.Payment.Controllers.SetupController.EvaluationsVm
@using Indamin.Payment.Data
@{ViewData["Title"]="ارزیابی قطعه–تامین‌کننده";var totalPages=Math.Max(1,(int)Math.Ceiling(Model.TotalCount/(double)Model.PageSize));}
<div class="page-header">
  <div><div class="eyebrow">اطلاعات پایه</div><h2>ارزیابی پارامترهای قطعه–تامین‌کننده</h2><p class="text-muted">مقادیر این جدول از میانگین امتیازهای ثبت‌شده توسط ارزیابان قطعه–تامین‌کننده به‌دست می‌آید و مستقیماً مبنای محاسبه پرداخت است.</p></div>
  <div class="export-group"><a class="btn btn-outline-primary" href="/Setup/ExportEvaluations">خروجی Excel</a></div>
</div>
<div class="info-box mb-3">سن بدهی موثر و مبلغ بدهی خودکار هستند و در این جدول نمایش داده نمی‌شوند. روی مقدار هر پارامتر کلیک کنید تا ریز امتیازهای ثبت‌شده توسط ارزیابان و میانگین فعلی آن مشاهده شود.</div>
<div class="table-panel">
  <form class="toolbar" method="get" action="/Setup/Evaluations"><input class="form-control" name="q" value="@Model.Search" placeholder="جست‌وجوی تامین‌کننده، کد قطعه یا عنوان قطعه..."><select class="form-select page-size-select" name="pageSize" onchange="this.form.submit()"><option value="25" selected="@(Model.PageSize==25)">25 ردیف</option><option value="50" selected="@(Model.PageSize==50)">50 ردیف</option><option value="75" selected="@(Model.PageSize==75)">75 ردیف</option><option value="100" selected="@(Model.PageSize==100)">100 ردیف</option></select><button class="btn btn-outline-primary">جست‌وجو</button></form>
  @await Html.PartialAsync("_TablePagination", (Model.Page,totalPages,Model.PageSize,Model.Search??"","/Setup/Evaluations"))
  <div class="table-responsive"><table id="evals" class="table modern-table align-middle">
    <thead><tr><th>تامین‌کننده</th><th>قطعه</th>@foreach(var p in Model.Parameters){<th class="text-center">@p.Title<br><span class="subtle">وزن @p.Weight٪</span></th>}</tr></thead>
    <tbody>
    @foreach(var m in Model.Mappings){
      <tr>
        <td class="fw-bold">@m.Supplier?.Title</td><td>@m.Part?.Code - @m.Part?.Title</td>
        @foreach(var p in Model.Parameters){
          var sc=Model.Scores.FirstOrDefault(x=>x.SupplierPartId==m.Id&&x.PaymentParameterId==p.Id);
          var score=sc?.Score??1m;
          <td class="score-cell text-center">
            <button type="button" class="btn btn-link score-detail-button" data-bs-toggle="modal" data-bs-target="#evaluationDetailsModal" data-url="@Url.Action("EvaluationDetails","Setup",new { supplierPartId=m.Id,parameterId=p.Id })" title="نمایش ریز امتیازهای ارزیابان">
              <strong>@score.ToString("0.##")</strong>
            </button>
          </td>
        }
      </tr>
    }
    @if(Model.Mappings.Count==0){<tr><td colspan="@(Model.Parameters.Count+2)" class="text-center text-muted py-4">موردی پیدا نشد.</td></tr>}
    </tbody>
  </table></div>
  @await Html.PartialAsync("_TablePagination", (Model.Page,totalPages,Model.PageSize,Model.Search??"","/Setup/Evaluations"))
</div>

<div class="modal fade" id="evaluationDetailsModal" tabindex="-1" aria-labelledby="evaluationDetailsLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable"><div class="modal-content border-0 shadow-lg">
    <div class="modal-header"><div><h5 class="modal-title" id="evaluationDetailsLabel">ریز امتیازهای ارزیابان</h5><div id="evaluationDetailsSubtitle" class="subtle mt-1"></div></div><button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="بستن"></button></div>
    <div class="modal-body">
      <div class="row g-3 mb-3">
        <div class="col-md-4"><label class="form-label">قطعه–تامین‌کننده</label><input id="evaluationDetailMap" class="form-control" readonly></div>
        <div class="col-md-4"><label class="form-label">پارامتر</label><input id="evaluationDetailParameter" class="form-control" readonly></div>
        <div class="col-md-4"><label class="form-label">میانگین</label><input id="evaluationDetailAverage" class="form-control fw-bold" readonly></div>
      </div>
      <div id="evaluationDetailEmpty" class="alert alert-secondary d-none">هنوز هیچ امتیازی توسط ارزیابان ثبت نشده است؛ مقدار مبنای پیش‌فرض ۱ است.</div>
      <div id="evaluationDetailTableWrap" class="table-responsive">
        <table class="table modern-table align-middle"><thead><tr><th>ارزیاب</th><th>امتیاز</th><th>آخرین ثبت</th></tr></thead><tbody id="evaluationDetailBody"></tbody></table>
      </div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-main" data-bs-dismiss="modal">بستن</button></div>
  </div></div>
</div>

<style>
.score-detail-button{text-decoration:none;min-width:68px;border-radius:10px}.score-detail-button:hover{background:#eef4f8}.score-cell{vertical-align:middle}
</style>
<script>
document.addEventListener("DOMContentLoaded",function(){
  const modal=document.getElementById("evaluationDetailsModal");
  const body=document.getElementById("evaluationDetailBody");
  const empty=document.getElementById("evaluationDetailEmpty");
  const wrap=document.getElementById("evaluationDetailTableWrap");
  document.querySelectorAll(".score-detail-button").forEach(btn=>{
    btn.addEventListener("click",async function(){
      body.innerHTML="";
      empty.classList.add("d-none");
      wrap.classList.remove("d-none");
      document.getElementById("evaluationDetailMap").value="در حال دریافت...";
      document.getElementById("evaluationDetailParameter").value="در حال دریافت...";
      document.getElementById("evaluationDetailAverage").value="...";
      try{
        const res=await fetch(btn.dataset.url,{headers:{"Accept":"application/json"}});
        if(!res.ok)throw new Error("request failed");
        const data=await res.json();
        document.getElementById("evaluationDetailMap").value=(data.part||"")+" / "+(data.supplier||"");
        document.getElementById("evaluationDetailParameter").value=data.parameter||"";
        document.getElementById("evaluationDetailAverage").value=Number(data.average||0).toLocaleString("fa-IR",{maximumFractionDigits:2});
        document.getElementById("evaluationDetailsSubtitle").textContent=(data.count||0)+" ارزیاب";
        if(!data.scores||data.scores.length===0){wrap.classList.add("d-none");empty.classList.remove("d-none");return;}
        data.scores.forEach(x=>{
          const tr=document.createElement("tr");
          tr.innerHTML="<td>"+escapeHtml(x.assessor||"—")+"</td><td><strong>"+Number(x.score||0).toLocaleString("fa-IR",{maximumFractionDigits:2})+"</strong></td><td>"+escapeHtml(x.updatedAt||"—")+"</td>";
          body.appendChild(tr);
        });
      }catch(e){
        wrap.classList.add("d-none");
        empty.classList.remove("d-none");
        empty.textContent="دریافت ریز امتیازها ناموفق بود.";
      }
    });
  });
  function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]||c));}
});
</script>
