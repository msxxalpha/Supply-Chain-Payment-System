@{
 ViewData["Title"]="راهنمای سیستم";
 var active=(string)(ViewBag.ActiveTab??"calculated");
}
<div class="page-header"><div><div class="eyebrow">راهنمای کاربری</div><h2>راهنمای سیستم پرداخت زنجیره تأمین</h2><p class="text-muted">راهنمای بخش‌بندی‌شده منطق پرداخت، توصیه تخصیص، فهرست بها، تعدیل نرخ و گزارش‌ها.</p></div></div>
<style>
.guide-tabs{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem}.guide-tabs a{padding:.65rem .9rem;border:1px solid #dbe3ea;border-radius:.65rem;color:inherit;text-decoration:none;background:#fff}.guide-tabs a.active{background:var(--navy,#102a43);color:#fff}.guide-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem}.guide-card{border:1px solid #dbe3ea;border-radius:1rem;padding:1rem;background:#fff;height:100%}.guide-card h4{font-size:1rem;font-weight:700;margin-bottom:.65rem}.guide-card p{line-height:1.9}.guide-note{border-right:4px solid var(--blue,#2d7fb3);padding:.8rem 1rem;background:rgba(45,127,179,.07);border-radius:.5rem;margin-top:1rem;line-height:1.9}
</style>
<nav class="guide-tabs" aria-label="بخش‌های راهنما">
<a class="@(active=="calculated"?"active":"")" href="/SystemGuide?tab=calculated">پرداخت محاسباتی</a><a class="@(active=="resilience"?"active":"")" href="/SystemGuide?tab=resilience">توصیه تخصیص غیرمحاسباتی</a><a class="@(active=="dashboard"?"active":"")" href="/SystemGuide?tab=dashboard">داشبورد</a><a class="@(active=="finance"?"active":"")" href="/SystemGuide?tab=finance">گزارش‌های مالی</a><a class="@(active=="supplier"?"active":"")" href="/SystemGuide?tab=supplier">مرور تأمین‌کننده</a><a class="@(active=="prices"?"active":"")" href="/SystemGuide?tab=prices">فهرست بها و تعدیل نرخ</a>
</nav>
@if(active=="calculated"){
<div class="guide-grid">
<section class="guide-card"><h4>پارامترها و وزن‌ها</h4><p>محاسبه از پارامترهای فعال و دارای وزن مثبت استفاده می‌کند. مجموع وزن‌ها باید ۱۰۰٪ باشد. امتیاز هر پارامتر در وزن آن ضرب و بر ۱۰۰ تقسیم می‌شود؛ جمع سهم پارامترها امتیاز وزنی ردیف قطعه–تأمین‌کننده است. برای روش دستی، امتیاز معتبر باید بین ۱ و سقف پارامتر باشد؛ روش‌های خودکار مطابق نوع تعریف‌شده امتیاز را محاسبه می‌کنند.</p></section>
<section class="guide-card"><h4>بودجه و سهم مطالبات</h4><p>بودجه تخصیص، سهم مطالبات استقراری و جاری و تنظیمات سامانه بر پیش‌نمایش اثر دارند. سهم استقراری و جاری در هر نوع پرداخت باید مجموعاً ۱۰۰٪ شود.</p></section>
<section class="guide-card"><h4>پیش‌نمایش و ثبت</h4><p>پیش‌نمایش برای بررسی امتیازها، مبالغ و هشدارهاست. پیش از تأیید، بودجه، مانده بدهی قابل پرداخت و پرداخت‌های قبلی را تطبیق دهید و از ثبت تکراری دستور پرداخت اجتناب کنید.</p></section>
</div><div class="guide-note">هر تغییر در فرمول یا تنظیمات باید هم‌زمان در این راهنما و آزمون‌های نرم‌افزار منعکس شود.</div>
}else if(active=="resilience"){
<div class="guide-grid">
<section class="guide-card"><h4>مشارکت پارامتر</h4><p>در «تنظیمات ← پارامترهای پرداخت»، گزینه «مشارکت در توصیه پرداخت غیرمحاسباتی» را فقط برای پارامترهایی فعال کنید که ارزیابی آن‌ها اهمیت تأمین را نشان می‌دهد. گزینه پیش‌فرض خاموش است و امتیازهای قبلی تغییر نمی‌کنند.</p></section>
<section class="guide-card"><h4>اهمیت تأمین</h4><p>فقط امتیازهای واقعی ارزیابان (نه امتیازهای پیش‌فرض سیستمی) استفاده می‌شوند. امتیاز معتبر از مقیاس ۱ تا سقف پارامتر به بازه ۰ تا ۱۰۰ تبدیل می‌شود. ابتدا امتیاز ارزیابان هر ارتباط قطعه–پارامتر میانگین‌گیری می‌شود؛ سپس ارتباط‌های هر پارامتر برای تأمین‌کننده و در پایان پارامترهای مشارکت‌کننده با وزن برابر تجمیع می‌شوند. این کار از غالب‌شدن پارامتری با تعداد ارتباط بیشتر جلوگیری می‌کند.</p></section>
<section class="guide-card"><h4>امتیاز تاب‌آوری آزمایشی</h4><p>۶۵٪ × شاخص اولویت مالی فعلی + ۳۵٪ × اهمیت تأمین. این نسبت موقت است و پیش از تبدیل به سیاست سازمانی باید با نتایج تاریخی ارزیابی و کالیبره شود.</p></section>
<section class="guide-card"><h4>تفسیر توصیه</h4><p>اگر امتیاز اهمیت تأمین موجود نباشد، «اطلاعات کافی نیست» نمایش داده می‌شود؛ صفر ساختگی تولید نمی‌شود. برای چنین ردیف‌هایی شاخص مالی فعلی معیار جایگزین ترتیب است.</p></section>
</div><div class="guide-note">توصیه پرداختی را خودکار ثبت نمی‌کند. انتخاب دستی تأمین‌کنندگان حفظ شده است؛ پیش از ادامه، بدهی معتبر، سقف بودجه و پرداخت‌های قبلی را کنترل کنید.</div>
}else if(active=="prices"){
<div class="guide-grid">
<section class="guide-card"><h4>۱. دامنه و پیش‌نیاز فهرست بها</h4><p>فهرست بها برای هر ارتباط فعال قطعه–تأمین‌کننده نگهداری می‌شود. پیش از ثبت قیمت، وجود قطعه، تأمین‌کننده و ارتباط فعال آن‌ها را در اطلاعات پایه کنترل کنید. قیمت خرید (فی) باید عددی بزرگ‌تر از صفر باشد و تاریخ پایان بازه نباید پیش از تاریخ شروع باشد. تاریخ‌ها در فرم به تقویم شمسی وارد می‌شوند.</p></section>
<section class="guide-card"><h4>۲. بازه اعتبار و نرخ هم‌پوشان</h4><p>برای یک قطعه–تأمین‌کننده می‌توان بازه‌های زمانی هم‌پوشان تعریف کرد. برای تاریخ هر رسید، فقط نرخ‌های فعال که تاریخ رسید بین تاریخ شروع و پایان آن‌ها (با احتساب هر دو روز مرزی) قرار دارد نامزد هستند. نرخ دارای جدیدترین تاریخ شروع انتخاب می‌شود؛ اگر تاریخ شروع برابر باشد، شناسه رکورد بزرگ‌تر اولویت دارد. نرخ غیرفعال در انتخاب نرخ شرکت نمی‌کند.</p></section>
<section class="guide-card"><h4>۳. ورود گروهی Excel</h4><p>ورود گروهی مخصوص مدیر سامانه است. ترتیب ستون‌ها: کد تأمین‌کننده، کد قطعه، قیمت خرید (فی)، تاریخ شروع و تاریخ پایان. ردیف اول باید عنوان ستون‌ها باشد؛ کدها باید به اطلاعات پایه معتبر اشاره کنند و ارتباط قطعه–تأمین‌کننده فعال باشد. قیمت باید مثبت و تاریخ‌ها معتبر باشند. اگر اعتبارسنجی حتی یک ردیف خطا داشته باشد، فایل به‌صورت گروهی ذخیره نمی‌شود. سقف هر عملیات تعدیل ۵۰۰۰ ردیف است.</p></section>
<section class="guide-card"><h4>۴. ویرایش و حذف نرخ</h4><p>نرخ استفاده‌شده در هر محاسبه پرداخت از طریق شناسه نرخ در Snapshot رسید قابل ردیابی است. اگر نرخ در سوابق محاسبه استفاده شده باشد، ویرایش و حذف مستقیم آن مجاز نیست؛ برای اصلاح، نرخ جایگزین ثبت کنید تا تاریخچه محاسبه قبلی بازنویسی نشود. نرخ غیرفعال‌شده با نرخ جدید، از انتخاب‌های بعدی کنار گذاشته می‌شود. نرخ‌های تکراری با همان قطعه، بازه دقیق و قیمت فعال دوباره ثبت نمی‌شوند.</p></section>
<section class="guide-card"><h4>۵. تغییر نرخ و شبیه‌سازی اثر مالی</h4><p>ثبت، ویرایش یا ورود گروهی نرخ از سرویس تعدیل بدهی عبور می‌کند. سرویس مجموعه نهایی نرخ‌های فعال را شبیه‌سازی می‌کند و رسیدهای جاری مؤثر را در بازه‌های تغییر بررسی می‌کند. برای هر رسید مشمول، نرخ معتبر در تاریخ رسید دوباره انتخاب می‌شود؛ اگر پس از تغییر، برای تاریخ رسید نرخ معتبری وجود نداشته باشد، عملیات رد می‌شود تا پوشش قیمت اصلاح شود. مقدار و قیمت رسید باید برای تعدیل معتبر باشند.</p></section>
<section class="guide-card"><h4>۶. فرمول تعدیل بدهی</h4><p>بدهی هدف هر رسید برابر است با مقدار رسید × فی جدید معتبر در تاریخ رسید. بدهی مؤثر قبلی برابر Snapshot بدهی اولیه به‌علاوه مجموع تعدیلات قبلی همان رسید است. تغییر بدهی = بدهی هدف − بدهی مؤثر قبلی. بنابراین تعدیل‌های تکراری به‌صورت تجمعی دوباره‌کاری نمی‌شوند و تغییر جدید نسبت به آخرین بدهی مؤثر محاسبه می‌شود؛ تغییر خالص گروه برابر مجموع تغییر بدهی رسیدهای متأثر است.</p></section>
<section class="guide-card"><h4>۷. اثر بر مانده و تخصیص‌های قبلی</h4><p>تعدیل در دفتر مستقل تعدیلات مالی با شناسه گروه، نرخ قبلی/جدید، بدهی قبلی/جدید، مبلغ تغییر، کاربر، زمان و دلیل ثبت می‌شود. مانده جاری رسید با بدهی مؤثر تعدیل‌شده، تخصیص‌های قبلی و تخصیص جاری محاسبه می‌شود و نباید منفی در نظر گرفته شود. Snapshot و سوابق دستور پرداخت/محاسبه قبلی بازنویسی نمی‌شوند؛ تعدیل در مانده قابل پرداخت بعدی و گزارش‌های مالی منعکس می‌شود.</p></section>
<section class="guide-card"><h4>۸. رسیدهای مشمول و کنترل نهایی</h4><p>در تعدیل قیمت، مبنا آخرین نسخه مالی مؤثر هر رسید است؛ اجراهای حذف‌شده کنار گذاشته می‌شوند و اجراهای دستور پرداخت‌شده یا تأییدشده با اثر مالی اعمال‌شده بررسی می‌شوند. فقط رسیدهای روش «مقدارمحور بر اساس فهرست بها» که تاریخشان در بازه تغییر قرار دارد مشمول‌اند. پس از تغییر نرخ، تعداد رسیدهای تعدیل‌شده و خالص تغییر بدهی را بررسی و در صورت نیاز، تاریخ رسید، مقدار، فی معتبر و مانده را با گزارش مالی تطبیق دهید.</p></section>
</div>
<div class="guide-note">قاعده مهم: هم‌پوشانی بازه‌ها به‌خودی‌خود خطا نیست؛ نرخ معتبر از روی تاریخ رسید و اولویت تاریخ شروع/شناسه انتخاب می‌شود. تغییر نرخ، پرداخت‌های گذشته را بازنویسی نمی‌کند و اثر مالی آن به‌صورت تعدیل مستند در مانده جاری ثبت می‌شود.</div>
}else if(active=="dashboard"){
<div class="guide-grid">
<section class="guide-card"><h4>فرمول شاخص اولویت مالی</h4><p>شاخص ۰ تا ۱۰۰ از این اجزا ساخته می‌شود: ۳۰٪ مانده تأمین‌کننده نسبت به بیشترین مانده؛ ۳۰٪ نسبت میانگین سن بدهی به مهلت تسویه که به بازه صفر تا دو محدود و بر دو تقسیم می‌شود؛ ۲۰٪ نسبت رسیدهای سررسیدگذشته به رسیدهای باز؛ ۱۵٪ کمبود پوشش پرداخت؛ و ۵٪ تعداد رسیدهای باز نسبت به سقف ۲۰ رسید. نتیجه با یک رقم اعشار گرد می‌شود. این شاخص برای مرتب‌سازی تحلیلی است و تضمین‌کننده فوریت واقعی تأمین نیست.</p></section>
<section class="guide-card"><h4>پوشش پرداخت</h4><p>در ردیف تأمین‌کننده، پوشش از پرداخت کل تقسیم بر مبنای مطالبات تاریخی به‌دست می‌آید؛ مبنا شامل مطالبه استقراری اولیه به‌علاوه پرداخت استقراری تاریخی، و مطالبات جاری باقی‌مانده به‌علاوه پرداخت جاری تاریخی است. کارت پوشش کلی داشبورد از کل پرداخت تقسیم بر مجموع مطالبات استقراری فعلی و مطالبات جاری فعلی استفاده می‌کند؛ بنابراین این دو عدد الزاماً تعریف یکسان ندارند.</p></section>
<section class="guide-card"><h4>فیلترها و نمودارها</h4><p>فیلترها دامنه بررسی را محدود و نمودارها روند و ترکیب را خلاصه می‌کنند. بازه زمانی، واحد مبلغ و فیلترهای فعال را قبل از برداشت مدیریتی کنترل کنید.</p></section>
</div>
}else if(active=="finance"){
<div class="guide-grid">
<section class="guide-card"><h4>مبلغ پرداخت مؤثر</h4><p>گزارش مالی اجراهای حذف‌نشده با وضعیت «دستور پرداخت شده» یا اجراهای «تأییدشده» که زمان اعمال اثر مالی دارند را مبنا می‌گیرد. در پرداخت غیرمحاسباتی، خطوط جزئیات مبنا هستند؛ برای رکوردهای قدیمی فاقد خطوط، سامانه از خلاصه‌های قدیمی استفاده می‌کند.</p></section>
<section class="guide-card"><h4>مانده مطالبات و رسیدها</h4><p>مانده جاری رسید از بدهی باقی‌مانده به‌علاوه تعدیلات قیمت، منهای تخصیص جاری و اعتبار جبرانی محاسبه می‌شود و منفی نمی‌ماند. آخرین نسخه مالی مؤثر هر کلید رسید مبناست و اعتبار مازاد به‌ترتیب رسیدهای قدیمی‌تر اعمال می‌شود. در روش فهرست بها، قیمت باید در تاریخ رسید معتبر باشد.</p></section>
<section class="guide-card"><h4>کنترل نهایی</h4><p>مانده بدهی، مبلغ تخصیص، بودجه، پرداخت‌های قبلی، تاریخ رسید و قیمت معتبر را تطبیق دهید. داده ناقص را مبنای گزارش قطعی قرار ندهید.</p></section>
</div>
}else{
<div class="guide-grid">
<section class="guide-card"><h4>مطالبات استقراری و جاری</h4><p>ترکیب مطالبات و وضعیت مالی هر تأمین‌کننده را به تفکیک نوع مطالبه و در کنار تاریخ و وضعیت پرداخت بررسی کنید.</p></section>
<section class="guide-card"><h4>قطعات مرتبط</h4><p>ارتباط قطعه–تأمین‌کننده زمینه بررسی امتیازها و اهمیت تأمین را فراهم می‌کند. وضعیت فعال ارتباط بر داده‌های مورد استفاده در توصیه اثر دارد.</p></section>
<section class="guide-card"><h4>تاریخچه و تفسیر</h4><p>مرور تأمین‌کننده، پرداخت‌های محاسباتی و غیرمحاسباتی، مانده مطالبات و سوابق مرتبط را کنار هم قرار می‌دهد. ارقام را با وضعیت اجرا، تعدیلات قیمت، تاریخ رسید و فیلترهای فعال تطبیق دهید؛ شاخص اولویت، امتیاز تاب‌آوری و پوشش مالی مفاهیم متفاوت‌اند.</p></section>
</div>
}
