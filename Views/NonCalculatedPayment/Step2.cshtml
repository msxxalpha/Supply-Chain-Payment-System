@model Indamin.Payment.Data.NonCalculatedPaymentWizardState
@using Indamin.Payment.Data
@{ViewData["Title"]="پرداخت غیرمحاسباتی؛ تعیین مبلغ";}
<div class="wizard-steps"><div class="wizard-step done"><span class="num">✓</span><div><b>انتخاب تامین‌کنندگان</b><small>@Model.Suppliers.Count تامین‌کننده</small></div></div><div class="wizard-step active"><span class="num">۲</span><div><b>نوع و مبلغ پرداخت</b><small>بررسی و تایید نهایی</small></div></div></div>
<div class="page-header"><div><div class="eyebrow">پرداخت غیرمحاسباتی</div><h2>@Model.Title</h2><p class="text-muted">تاریخ ثبت: @Model.PaymentDateJalali — سهم پرداخت بین مطالبات استقراری و جاری طبق پارامترهای سیستم تقسیم و در زمان تایید ثبت می‌شود.</p></div></div>
<form method="post" action="/NonCalculatedPayment/Approve" id="nonCalcApproveForm">
@Html.AntiForgeryToken()
<div class="table-panel"><div class="panel-title"><div><h4>اطلاعات نهایی پرداخت</h4><span>در صورت کافی نبودن یک منبع مطالبات، سهم باقی‌مانده خودکار به منبع دیگر منتقل می‌شود.</span></div></div>
<div class="table-responsive"><table class="table modern-table"><thead><tr><th>#</th><th>تامین‌کننده</th><th>مطالبات استقراری</th><th>مانده مطالبات جاری</th><th>مجموع مطالبات</th><th>نوع پرداخت</th><th>مبلغ (ریال)</th></tr></thead><tbody>
@for(var i=0;i<Model.Suppliers.Count;i++){var s=Model.Suppliers[i];<tr><td>@(i+1)</td><td class="fw-bold">@s.SupplierTitle<input type="hidden" name="items[@i].SupplierId" value="@s.SupplierId"></td><td>@s.InitialClaimAmount.ToString("N0")</td><td>@s.CurrentDebt.ToString("N0")</td><td class="amount-emphasis">@s.TotalDebt.ToString("N0")</td><td><select class="form-select" name="items[@i].PaymentType"><option value="Cash">نقدی</option><option value="CheckTransfer">واگذاری چک</option><option value="VehicleTransfer">واگذاری خودرو</option><option value="RawMaterialTransfer">واگذاری مواداولیه</option><option value="IntroductionLetter">معرفی نامه</option><option value="CreditLimit">حد اعتباری</option></select></td><td><input class="form-control money-input" name="items[@i].Amount" type="text" inputmode="decimal" value="0" required></td></tr>}
</tbody></table></div></div>
<div class="info-box mt-3"><b>روش تسویه خودکار مطالبات:</b> سهم استقراری و جاری از پارامترهای سیستم خوانده می‌شود. در پرداخت جاری، تخصیص از قدیمی‌ترین رسیدها شروع می‌شود و تا صفر شدن هر رسید ادامه پیدا می‌کند؛ اگر مانده یک منبع کمتر از سهم آن باشد، کسری به منبع دیگر منتقل می‌شود.</div>
<div class="step-actions"><a class="btn btn-outline-secondary" href="/NonCalculatedPayment/Step1">← بازگشت و اصلاح تامین‌کنندگان</a><span class="subtle">پس از تایید، پرداخت در سوابق ثبت می‌شود و تا قبل از دستور پرداخت امکان حذف منطقی دارد.</span><button class="btn btn-main btn-lg" type="submit">ثبت نهایی و تایید پرداخت</button></div>
</form>
<script>
(function(){
 function norm(s){return(s||"").replace(/[۰-۹]/g,c=>String("۰۱۲۳۴۵۶۷۸۹".indexOf(c))).replace(/[٠-٩]/g,c=>String("٠١٢٣٤٥٦٧٨٩".indexOf(c))).replace(/٬/g,"").replace(/,/g,"").replace(/٫/g,".").replace(/\s/g,"");}
 document.querySelectorAll(".money-input").forEach(el=>{el.addEventListener("focus",()=>{el.value=norm(el.value);});el.addEventListener("blur",()=>{const n=Number(norm(el.value).replace(/[^0-9.]/g,""))||0;el.value=new Intl.NumberFormat("fa-IR",{maximumFractionDigits:0}).format(n);});});
 document.getElementById("nonCalcApproveForm").addEventListener("submit",()=>document.querySelectorAll(".money-input").forEach(el=>{el.value=norm(el.value).replace(/[^0-9.]/g,"")||"0";}));
})();
</script>