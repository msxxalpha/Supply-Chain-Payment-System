@model Indamin.Payment.Data.NonCalculatedPaymentWizardState
@using Indamin.Payment.Data
@{
    ViewData["Title"] = "پرداخت غیرمحاسباتی؛ انتخاب تامین‌کنندگان";
}
<div class="wizard-steps">
    <div class="wizard-step active"><span class="num">۱</span><div><b>انتخاب تامین‌کنندگان</b><small>تشکیل فهرست پرداخت</small></div></div>
    <div class="wizard-step"><span class="num">۲</span><div><b>ثبت اقلام پرداخت</b><small>نوع، مبلغ و توضیحات</small></div></div>
    <div class="wizard-step"><span class="num">۳</span><div><b>پیش‌نمایش و ثبت نهایی</b><small>کنترل منابع و صدور دستور پرداخت</small></div></div>
</div>

<div class="page-header">
    <div>
        <div class="eyebrow">پرداخت غیرمحاسباتی</div>
        <h2>انتخاب تامین‌کنندگان</h2>
        <p class="text-muted">فهرست سمت راست دقیقاً با ترتیب شاخص تحلیل تامین‌کنندگان داشبورد نمایش داده می‌شود. یک تامین‌کننده را می‌توان چند بار به فهرست پرداخت منتقل کرد.</p>
    </div>
    <button type="button" id="openAllocationRecommendation" class="btn btn-main">✦ توصیه تخصیص</button>
    <a class="btn btn-outline-secondary" href="/PaymentWizard/History">سوابق پرداخت‌ها</a>
</div>

<form method="post" action="/NonCalculatedPayment/Step1" id="nonCalcStep1Form">
@Html.AntiForgeryToken()

<div class="form-panel mb-3">
    <div class="row g-3">
        <div class="col-lg-5">
            <label class="form-label">عنوان پرداخت</label>
            <input class="form-control" name="title" value="@Model.Title" required>
        </div>
        <div class="col-lg-3">
            <label class="form-label">تاریخ پرداخت</label>
            <div class="jalali-input">
                <input class="form-control" data-jalali-date name="paymentDateJalali" value="@Model.PaymentDateJalali" autocomplete="off" required>
                <button class="date-trigger" type="button" data-jalali-trigger>▣</button>
            </div>
        </div>
        <div class="col-lg-4">
            <label class="form-label">توضیحات کلی پرداخت</label>
            <input class="form-control" name="notes" value="@Model.Notes">
        </div>
    </div>
</div>

<div class="row g-3 align-items-stretch">
    <div class="col-xl-5">
        <div class="table-panel h-100">
            <div class="panel-title">
                <div><h4>فهرست انتخاب‌شده</h4><span>هر ردیف یک آیتم مستقل است و تکرار تامین‌کننده مجاز است.</span></div>
                <span id="selectedCount" class="validation-chip">۰ آیتم</span>
            </div>
            <div class="table-responsive table-scroll">
                <table class="table modern-table" id="selectedSuppliers">
                    <thead><tr><th>تامین‌کننده</th><th>استقراری</th><th>جاری</th><th>کل مطالبات</th></tr></thead>
                    <tbody>
                    @foreach(var x in Model.Suppliers)
                    {
                        <tr data-id="@x.SupplierId" class="@(Model.Suppliers.IndexOf(x)==Model.Suppliers.Count-1?"":"")">
                            <td class="fw-bold">@x.SupplierTitle</td>
                            <td>@x.InitialClaimAmount.ToString("N0")</td>
                            <td>@x.CurrentDebt.ToString("N0")</td>
                            <td class="amount-emphasis">@x.TotalDebt.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-1 d-flex flex-xl-column justify-content-center align-items-center gap-2">
        <button type="button" id="moveSelected" class="btn btn-main btn-lg" title="افزودن ردیف انتخاب‌شده">←</button>
        <button type="button" id="removeSelected" class="btn btn-outline-secondary btn-lg" title="حذف ردیف انتخاب‌شده">→</button>
    </div>

    <div class="col-xl-6">
        <div class="table-panel h-100">
            <div class="panel-title">
                <div><h4>تحلیل تامین‌کنندگان</h4><span>ترتیب با داشبورد گزارش‌های مالی یکسان است.</span></div>
                <span class="validation-chip">@Model.AvailableSuppliers.Count تامین‌کننده</span>
            </div>
            <div class="filter-bar">
                <input id="supplierFilter" class="form-control" placeholder="فیلتر بر اساس نام تامین‌کننده..." autocomplete="off">
            </div>
            <div class="table-responsive table-scroll">
                <table class="table modern-table" id="availableSuppliers">
                    <thead><tr><th>تامین‌کننده</th><th>شاخص</th><th>استقراری</th><th>جاری</th><th>کل مطالبات</th></tr></thead>
                    <tbody>
                    @foreach(var x in Model.AvailableSuppliers)
                    {
                        <tr data-id="@x.SupplierId" data-title="@x.SupplierTitle" data-initial="@x.InitialClaimAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-current="@x.CurrentDebt.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-total="@x.TotalDebt.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-priority="@x.Priority.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-coverage="@x.Coverage.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-age="@x.AgeRatio.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-overdue="@x.Overdue" data-open="@x.OpenReceiptCount">
                            <td class="fw-bold">@x.SupplierTitle</td>
                            <td><span class="priority-pill">@x.Priority</span></td>
                            <td>@x.InitialClaimAmount.ToString("N0")</td>
                            <td>@x.CurrentDebt.ToString("N0")</td>
                            <td class="amount-emphasis">@x.TotalDebt.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="selectedHiddenFields"></div>
<div class="step-actions">
    <span class="subtle">برای افزودن یک تامین‌کننده: سطر را انتخاب کنید و دکمه «←» را بزنید. همان تامین‌کننده می‌تواند دوباره انتخاب شود.</span>
    <button id="continueNonCalc" type="submit" class="btn btn-main btn-lg">ادامه به ثبت اقلام پرداخت ←</button>
</div>
</form>

<script>
(function(){
    const available = document.querySelector("#availableSuppliers tbody");
    const selected = document.querySelector("#selectedSuppliers tbody");
    const hidden = document.getElementById("selectedHiddenFields");
    const count = document.getElementById("selectedCount");
    const filter = document.getElementById("supplierFilter");

    function num(v){ return Number(v||0).toLocaleString("fa-IR",{maximumFractionDigits:0}); }

    function clearSelection(){
        document.querySelectorAll("#availableSuppliers tbody tr, #selectedSuppliers tbody tr")
            .forEach(r=>r.classList.remove("table-active"));
    }

    function refresh(){
        const rows = [...selected.querySelectorAll("tr")];
        count.textContent = rows.length.toLocaleString("fa-IR") + " آیتم";
        hidden.innerHTML = "";
        rows.forEach(row=>{
            const input=document.createElement("input");
            input.type="hidden";
            input.name="supplierIds";
            input.value=row.dataset.id;
            hidden.appendChild(input);
        });
    }

    available.addEventListener("click", e=>{
        const row=e.target.closest("tr");
        if(!row)return;
        clearSelection();
        row.classList.add("table-active");
    });

    selected.addEventListener("click", e=>{
        const row=e.target.closest("tr");
        if(!row)return;
        clearSelection();
        row.classList.add("table-active");
    });

    document.getElementById("moveSelected").addEventListener("click",()=>{
        const row=available.querySelector("tr.table-active");
        if(!row)return;
        const tr=document.createElement("tr");
        tr.dataset.id=row.dataset.id;
        tr.innerHTML="<td class='fw-bold'>"+row.dataset.title+"</td>"
          +"<td>"+num(row.dataset.initial)+"</td>"
          +"<td>"+num(row.dataset.current)+"</td>"
          +"<td class='amount-emphasis'>"+num(Number(row.dataset.initial||0)+Number(row.dataset.current||0))+"</td>";
        selected.appendChild(tr);
        clearSelection();
        refresh();
    });

    document.getElementById("removeSelected").addEventListener("click",()=>{
        const row=selected.querySelector("tr.table-active");
        if(!row)return;
        row.remove();
        clearSelection();
        refresh();
    });

    filter.addEventListener("input",()=>{
        const q=(filter.value||"").trim().toLocaleLowerCase();
        available.querySelectorAll("tr").forEach(row=>{
            const title=(row.dataset.title||"").toLocaleLowerCase();
            row.style.display=!q || title.includes(q) ? "" : "none";
        });
    });

    document.getElementById("nonCalcStep1Form").addEventListener("submit",e=>{
        if(selected.querySelectorAll("tr").length===0){
            e.preventDefault();
            alert("حداقل یک تامین‌کننده را انتخاب کنید.");
        }
    });

    refresh();
})();
</script>