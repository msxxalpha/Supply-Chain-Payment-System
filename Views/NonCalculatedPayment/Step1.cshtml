@model Indamin.Payment.Data.NonCalculatedPaymentWizardState
@using Indamin.Payment.Data
@{
    ViewData["Title"] = "پرداخت غیرمحاسباتی؛ انتخاب تامین‌کنندگان";
}
<div class="wizard-steps">
    <div class="wizard-step active"><span class="num">۱</span><div><b>انتخاب تامین‌کنندگان</b><small>تشکیل فهرست پرداخت</small></div></div>
    <div class="wizard-step"><span class="num">۲</span><div><b>ثبت اقلام پرداخت</b><small>نوع، مبلغ و توضیحات</small></div></div>
    <div class="wizard-step"><span class="num">۳</span><div><b>پیش‌نمایش و ثبت نهایی</b><small>کنترل منابع و صدور دستور پرداخت</small></div></div>
</div>

<div class="page-header">
    <div>
        <div class="eyebrow">پرداخت غیرمحاسباتی</div>
        <h2>انتخاب تامین‌کنندگان</h2>
        <p class="text-muted">فهرست سمت راست دقیقاً با ترتیب شاخص تحلیل تامین‌کنندگان داشبورد نمایش داده می‌شود. یک تامین‌کننده را می‌توان چند بار به فهرست پرداخت منتقل کرد.</p>
    </div>
    <button type="button" id="openAllocationRecommendation" class="btn btn-main">✦ توصیه تخصیص</button>
    <a class="btn btn-outline-secondary" href="/PaymentWizard/History">سوابق پرداخت‌ها</a>
</div>

<form method="post" action="/NonCalculatedPayment/Step1" id="nonCalcStep1Form">
@Html.AntiForgeryToken()

<div class="form-panel mb-3">
    <div class="row g-3">
        <div class="col-lg-5">
            <label class="form-label">عنوان پرداخت</label>
            <input class="form-control" name="title" value="@Model.Title" required>
        </div>
        <div class="col-lg-3">
            <label class="form-label">تاریخ پرداخت</label>
            <div class="jalali-input">
                <input class="form-control" data-jalali-date name="paymentDateJalali" value="@Model.PaymentDateJalali" autocomplete="off" required>
                <button class="date-trigger" type="button" data-jalali-trigger>▣</button>
            </div>
        </div>
        <div class="col-lg-4">
            <label class="form-label">توضیحات کلی پرداخت</label>
            <input class="form-control" name="notes" value="@Model.Notes">
        </div>
    </div>
</div>

<div class="row g-3 align-items-stretch">
    <div class="col-xl-5">
        <div class="table-panel h-100">
            <div class="panel-title">
                <div><h4>فهرست انتخاب‌شده</h4><span>هر ردیف یک آیتم مستقل است و تکرار تامین‌کننده مجاز است.</span></div>
                <span id="selectedCount" class="validation-chip">۰ آیتم</span>
            </div>
            <div class="table-responsive table-scroll">
                <table class="table modern-table" id="selectedSuppliers">
                    <thead><tr><th>تامین‌کننده</th><th>استقراری</th><th>جاری</th><th>کل مطالبات</th></tr></thead>
                    <tbody>
                    @foreach(var x in Model.Suppliers)
                    {
                        <tr data-id="@x.SupplierId" class="@(Model.Suppliers.IndexOf(x)==Model.Suppliers.Count-1?"":"")">
                            <td class="fw-bold">@x.SupplierTitle</td>
                            <td>@x.InitialClaimAmount.ToString("N0")</td>
                            <td>@x.CurrentDebt.ToString("N0")</td>
                            <td class="amount-emphasis">@x.TotalDebt.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-1 d-flex flex-xl-column justify-content-center align-items-center gap-2">
        <button type="button" id="moveSelected" class="btn btn-main btn-lg" title="افزودن ردیف انتخاب‌شده">←</button>
        <button type="button" id="removeSelected" class="btn btn-outline-secondary btn-lg" title="حذف ردیف انتخاب‌شده">→</button>
    </div>

    <div class="col-xl-6">
        <div class="table-panel h-100">
            <div class="panel-title">
                <div><h4>تحلیل تامین‌کنندگان</h4><span>ترتیب با داشبورد گزارش‌های مالی یکسان است.</span></div>
                <span class="validation-chip">@Model.AvailableSuppliers.Count تامین‌کننده</span>
            </div>
            <div class="filter-bar">
                <input id="supplierFilter" class="form-control" placeholder="فیلتر بر اساس نام تامین‌کننده..." autocomplete="off">
            </div>
            <div class="table-responsive table-scroll">
                <table class="table modern-table" id="availableSuppliers">
                    <thead><tr><th>تامین‌کننده</th><th>شاخص</th><th>استقراری</th><th>جاری</th><th>کل مطالبات</th></tr></thead>
                    <tbody>
                    @foreach(var x in Model.AvailableSuppliers)
                    {
                        <tr data-id="@x.SupplierId" data-title="@x.SupplierTitle" data-initial="@x.InitialClaimAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-current="@x.CurrentDebt.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-total="@x.TotalDebt.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-priority="@x.Priority.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-coverage="@x.Coverage.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-age="@x.AgeRatio.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-overdue="@x.Overdue" data-open="@x.OpenReceiptCount">
                            <td class="fw-bold">@x.SupplierTitle</td>
                            <td><span class="priority-pill">@x.Priority</span></td>
                            <td>@x.InitialClaimAmount.ToString("N0")</td>
                            <td>@x.CurrentDebt.ToString("N0")</td>
                            <td class="amount-emphasis">@x.TotalDebt.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="selectedHiddenFields"></div>
<div class="step-actions">
    <span class="subtle">برای افزودن یک تامین‌کننده: سطر را انتخاب کنید و دکمه «←» را بزنید. همان تامین‌کننده می‌تواند دوباره انتخاب شود.</span>
    <button id="continueNonCalc" type="submit" class="btn btn-main btn-lg">ادامه به ثبت اقلام پرداخت ←</button>
</div>
</form>

<script>
(function(){
    const available = document.querySelector("#availableSuppliers tbody");
    const selected = document.querySelector("#selectedSuppliers tbody");
    const hidden = document.getElementById("selectedHiddenFields");
    const count = document.getElementById("selectedCount");
    const filter = document.getElementById("supplierFilter");

    function num(v){ return Number(v||0).toLocaleString("fa-IR",{maximumFractionDigits:0}); }

    function clearSelection(){
        document.querySelectorAll("#availableSuppliers tbody tr, #selectedSuppliers tbody tr")
            .forEach(r=>r.classList.remove("table-active"));
    }

    function refresh(){
        const rows = [...selected.querySelectorAll("tr")];
        count.textContent = rows.length.toLocaleString("fa-IR") + " آیتم";
        hidden.innerHTML = "";
        rows.forEach(row=>{
            const input=document.createElement("input");
            input.type="hidden";
            input.name="supplierIds";
            input.value=row.dataset.id;
            hidden.appendChild(input);
        });
    }

    available.addEventListener("click", e=>{
        const row=e.target.closest("tr");
        if(!row)return;
        clearSelection();
        row.classList.add("table-active");
    });

    selected.addEventListener("click", e=>{
        const row=e.target.closest("tr");
        if(!row)return;
        clearSelection();
        row.classList.add("table-active");
    });

    document.getElementById("moveSelected").addEventListener("click",()=>{
        const row=available.querySelector("tr.table-active");
        if(!row)return;
        const tr=document.createElement("tr");
        tr.dataset.id=row.dataset.id;
        tr.innerHTML="<td class='fw-bold'>"+row.dataset.title+"</td>"
          +"<td>"+num(row.dataset.initial)+"</td>"
          +"<td>"+num(row.dataset.current)+"</td>"
          +"<td class='amount-emphasis'>"+num(Number(row.dataset.initial||0)+Number(row.dataset.current||0))+"</td>";
        selected.appendChild(tr);
        clearSelection();
        refresh();
    });

    document.getElementById("removeSelected").addEventListener("click",()=>{
        const row=selected.querySelector("tr.table-active");
        if(!row)return;
        row.remove();
        clearSelection();
        refresh();
    });

    filter.addEventListener("input",()=>{
        const q=(filter.value||"").trim().toLocaleLowerCase();
        available.querySelectorAll("tr").forEach(row=>{
            const title=(row.dataset.title||"").toLocaleLowerCase();
            row.style.display=!q || title.includes(q) ? "" : "none";
        });
    });

    document.getElementById("nonCalcStep1Form").addEventListener("submit",e=>{
        if(selected.querySelectorAll("tr").length===0){
            e.preventDefault();
            alert("حداقل یک تامین‌کننده را انتخاب کنید.");
        }
    });

    refresh();
})();
</script>
<div id="allocationRecommendationModal" class="allocation-recommendation-backdrop" aria-hidden="true">
  <section class="allocation-recommendation-modal" role="dialog" aria-modal="true" aria-labelledby="allocationRecommendationTitle">
    <header class="allocation-recommendation-header">
      <div>
        <div class="eyebrow">تحلیل اولویت پرداخت</div>
        <h3 id="allocationRecommendationTitle">توصیه تخصیص به تامین‌کنندگان</h3>
        <p>امتیاز اولویت از مانده مطالبات، سن بدهی نسبت به مهلت تسویه، سررسیدگذشتگی، پوشش پرداخت و تعداد رسیدهای باز استفاده می‌کند. این فهرست پیشنهاد تحلیلی است و جایگزین تصمیم نهایی شما نیست.</p>
      </div>
      <button type="button" class="allocation-recommendation-close" data-close-recommendation aria-label="بستن">×</button>
    </header>
    <div class="allocation-recommendation-summary">
      <span>ترتیب: امتیاز اولویت بیشتر، پوشش پرداخت کمتر، سپس مانده مطالبات بیشتر</span>
      <strong id="recommendationLimitLabel"></strong>
    </div>
    <div class="table-responsive allocation-recommendation-table-wrap">
      <table class="table modern-table allocation-recommendation-table">
        <thead><tr>
          <th class="recommendation-check-cell"><input type="checkbox" id="recommendationSelectAll" aria-label="انتخاب یا لغو انتخاب همه ردیف‌ها"></th>
          <th>رتبه</th><th>تامین‌کننده</th><th>مطالبات کل</th><th>پوشش پرداخت</th><th>رسید باز</th><th>سررسیدگذشته</th><th>سن بدهی/مهلت</th><th>امتیاز اولویت</th>
        </tr></thead>
        <tbody id="allocationRecommendationRows">
        @foreach(var x in Model.AvailableSuppliers)
        {
          <tr data-id="@x.SupplierId" data-title="@x.SupplierTitle" data-initial="@x.InitialClaimAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-current="@x.CurrentDebt.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-total="@x.TotalDebt.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-priority="@x.Priority.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-coverage="@x.Coverage.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-age="@x.AgeRatio.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-overdue="@x.Overdue" data-open="@x.OpenReceiptCount">
            <td class="recommendation-check-cell"><input type="checkbox" class="recommendation-row-check" aria-label="انتخاب تامین‌کننده @x.SupplierTitle"></td>
            <td class="recommendation-rank"></td>
            <td class="fw-bold">@x.SupplierTitle</td>
            <td class="amount-emphasis">@x.TotalDebt.ToString("N0")</td>
            <td>@((x.Coverage * 100m).ToString("N1"))٪</td>
            <td>@x.OpenReceiptCount.ToString("N0")</td>
            <td>@x.Overdue.ToString("N0")</td>
            <td>@x.AgeRatio.ToString("N2")</td>
            <td><span class="priority-pill">@x.Priority.ToString("N1")</span></td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    <footer class="allocation-recommendation-footer">
      <span id="recommendationSelectedCount">۰ تامین‌کننده انتخاب‌شده</span>
      <div>
        <button type="button" class="btn btn-outline-secondary" data-close-recommendation>انصراف</button>
        <button type="button" id="applyAllocationRecommendation" class="btn btn-main">ثبت و جایگزینی فهرست منتخب</button>
      </div>
    </footer>
  </section>
</div>
<div id="selectedRowContextMenu" class="selected-row-context-menu" role="menu">
  <button type="button" id="copySupplierRow" role="menuitem">کپی ردیف</button>
  <button type="button" id="pasteSupplierRow" role="menuitem" disabled>جایگذاری ردیف کپی‌شده</button>
</div>
<script>
(function(){
  const trigger=document.getElementById("openAllocationRecommendation");
  const modal=document.getElementById("allocationRecommendationModal");
  const rowsBody=document.getElementById("allocationRecommendationRows");
  const selectAll=document.getElementById("recommendationSelectAll");
  const limitLabel=document.getElementById("recommendationLimitLabel");
  const selectedCount=document.getElementById("recommendationSelectedCount");
  const selectedBody=document.querySelector("#selectedSuppliers tbody");
  const hidden=document.getElementById("selectedHiddenFields");
  const countBadge=document.getElementById("selectedCount");
  const contextMenu=document.getElementById("selectedRowContextMenu");
  let copiedRow=null, contextTarget=null;

  function normalizeDigits(v){return String(v||"").replace(/[۰-۹]/g,d=>String("۰۱۲۳۴۵۶۷۸۹".indexOf(d))).replace(/[٠-٩]/g,d=>String("٠١٢٣٤٥٦٧٨٩".indexOf(d)));}
  function fmt(v){return Number(v||0).toLocaleString("fa-IR",{maximumFractionDigits:0});}
  function refreshSelected(){
    const rows=[...selectedBody.querySelectorAll("tr")];
    countBadge.textContent=rows.length.toLocaleString("fa-IR")+" آیتم";
    hidden.replaceChildren();
    rows.forEach(row=>{
      const input=document.createElement("input");
      input.type="hidden";input.name="supplierIds";input.value=row.dataset.id;
      hidden.appendChild(input);
    });
  }
  function makeSelectedRow(source){
    const tr=document.createElement("tr");
    tr.dataset.id=source.dataset.id;
    tr.dataset.title=source.dataset.title;
    tr.dataset.initial=source.dataset.initial;
    tr.dataset.current=source.dataset.current;
    const values=[
      [source.dataset.title,"fw-bold"],
      [fmt(source.dataset.initial)," "],
      [fmt(source.dataset.current)," "],
      [fmt(Number(source.dataset.initial||0)+Number(source.dataset.current||0)),"amount-emphasis"]
    ];
    values.forEach(([value,cls])=>{const td=document.createElement("td");td.className=cls;td.textContent=value;tr.appendChild(td);});
    return tr;
  }
  function closeModal(){modal.classList.remove("is-open");modal.setAttribute("aria-hidden","true");document.body.classList.remove("recommendation-modal-open");}
  function updateCheckCount(){
    const visible=[...rowsBody.querySelectorAll("tr")].filter(row=>row.style.display!=="none");
    const checked=visible.filter(row=>row.querySelector(".recommendation-row-check").checked).length;
    selectedCount.textContent=checked.toLocaleString("fa-IR")+" تامین‌کننده انتخاب‌شده";
    selectAll.checked=visible.length>0&&checked===visible.length;
    selectAll.indeterminate=checked>0&&checked<visible.length;
  }
  trigger.addEventListener("click",()=>{
    const raw=window.prompt("جدول پیشنهادی اولویت‌بندی‌شده شامل چند تامین‌کننده باشد؟",String(Math.min(10,rowsBody.querySelectorAll("tr").length)));
    if(raw===null)return;
    const n=Number(normalizeDigits(raw).replace(/[^0-9]/g,""));
    if(!Number.isInteger(n)||n<1){window.alert("تعداد باید عدد صحیح بزرگ‌تر از صفر باشد.");return;}
    const candidates=[...rowsBody.querySelectorAll("tr")];
    candidates.sort((a,b)=>Number(b.dataset.priority)-Number(a.dataset.priority)||Number(a.dataset.coverage)-Number(b.dataset.coverage)||Number(b.dataset.total)-Number(a.dataset.total)||Number(b.dataset.overdue)-Number(a.dataset.overdue));
    candidates.forEach((row,index)=>{
      rowsBody.appendChild(row);
      row.style.display=index<Math.min(n,candidates.length)?"":"none";
      row.querySelector(".recommendation-row-check").checked=false;
      row.querySelector(".recommendation-rank").textContent=(index+1).toLocaleString("fa-IR");
    });
    limitLabel.textContent=Math.min(n,candidates.length).toLocaleString("fa-IR")+" از "+candidates.length.toLocaleString("fa-IR")+" تامین‌کننده واجد شرایط";
    selectAll.checked=false;selectAll.indeterminate=false;updateCheckCount();
    modal.classList.add("is-open");modal.setAttribute("aria-hidden","false");document.body.classList.add("recommendation-modal-open");
  });
  selectAll.addEventListener("change",()=>{
    rowsBody.querySelectorAll("tr").forEach(row=>{if(row.style.display!=="none")row.querySelector(".recommendation-row-check").checked=selectAll.checked;});
    updateCheckCount();
  });
  rowsBody.addEventListener("change",e=>{if(e.target.classList.contains("recommendation-row-check"))updateCheckCount();});
  modal.querySelectorAll("[data-close-recommendation]").forEach(btn=>btn.addEventListener("click",closeModal));
  modal.addEventListener("click",e=>{if(e.target===modal)closeModal();});
  document.addEventListener("keydown",e=>{if(e.key==="Escape"&&modal.classList.contains("is-open"))closeModal();});
  document.getElementById("applyAllocationRecommendation").addEventListener("click",()=>{
    const chosen=[...rowsBody.querySelectorAll("tr")].filter(row=>row.style.display!=="none"&&row.querySelector(".recommendation-row-check").checked);
    if(!chosen.length){window.alert("حداقل یک تامین‌کننده را انتخاب کنید.");return;}
    selectedBody.replaceChildren();
    chosen.forEach(row=>selectedBody.appendChild(makeSelectedRow(row)));
    refreshSelected();closeModal();
  });

  function hideMenu(){contextMenu.classList.remove("is-open");contextTarget=null;}
  selectedBody.addEventListener("contextmenu",e=>{
    const row=e.target.closest("tr");if(!row)return;
    e.preventDefault();contextTarget=row;
    contextMenu.style.left=Math.max(8,Math.min(e.clientX,window.innerWidth-215))+"px";
    contextMenu.style.top=Math.max(8,Math.min(e.clientY,window.innerHeight-105))+"px";
    contextMenu.classList.add("is-open");
    document.getElementById("pasteSupplierRow").disabled=!copiedRow;
  });
  document.getElementById("copySupplierRow").addEventListener("click",()=>{
    if(contextTarget)copiedRow=contextTarget.cloneNode(true);
    document.getElementById("pasteSupplierRow").disabled=!copiedRow;
    hideMenu();
  });
  document.getElementById("pasteSupplierRow").addEventListener("click",()=>{
    if(!copiedRow)return;
    const duplicate=copiedRow.cloneNode(true);
    if(contextTarget&&contextTarget.isConnected)contextTarget.after(duplicate);else selectedBody.appendChild(duplicate);
    hideMenu();refreshSelected();
  });
  document.addEventListener("click",e=>{if(!e.target.closest("#selectedRowContextMenu"))hideMenu();});
  window.addEventListener("scroll",hideMenu,true);
})();
</script>
